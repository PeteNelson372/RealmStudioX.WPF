<ui:ModalDialog x:Class="RealmStudioX.WPF.Views.Dialogs.ObjectCharacteristics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:RealmStudioX.WPF.Views"
        xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
        xmlns:vm="clr-namespace:RealmStudioX.WPF.ViewModels.Dialogs"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="Realm Properties"
        Width="440"
        Height="360"
        MinWidth="440"
        MaxWidth="440"
        MinHeight="360"
        MaxHeight="360"
        Background="#FF45443F"
        WindowStyle="None"
        ResizeMode="NoResize">
   
    <Grid Margin="10" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- Custom Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Main -->
            <RowDefinition Height="80"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleBarText"
            Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Object Characteristics"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Background="#FF45443F"
                       Foreground="#E5E5E5"
                       VerticalAlignment="Top"
                       Height="30"
                       Padding="20,0,0,0"
                       Margin="0,0,0,0"/>
        
        <Border Grid.Row="1" Grid.Column="0" Padding="0" BorderBrush="Transparent" BorderThickness="0">
            <StackPanel>

                <GroupBox Margin="5,5,5,0" FontSize="12" FontWeight="Regular" Padding="0" Height="220" Header="Type">
                    
                    <StackPanel>
                        <ListBox x:Name="ObjectTypesList"
                         Width="135"
                         Height="185"
                         Margin="3,3,3,3"
                         SelectionMode="Single"
                         SelectedItem="{Binding SelectedObjectType}"
                         ItemsSource="{Binding ObjectTypes}">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}"
                                       IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                          Path=IsSelected}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

        </Border>

        <Border Grid.Row="1" Grid.Column="1" Padding="0" BorderBrush="Transparent" BorderThickness="0">
            <StackPanel>

                <GroupBox Margin="5,5,5,0" FontSize="12" FontWeight="Regular" Padding="0" Height="220" Header="Characteristics">

                    <StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Height="160" MaxHeight="160">
                            
                            <ItemsControl
                              Margin="6,6,6,0"                              
                              ItemsSource="{Binding ObjectCharacteristicsList}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Margin="3"
                                        Padding="8,3"
                                        CornerRadius="12"
                                        Background="#FFE8E8E8"
                                        BorderBrush="#FFC8C8C8"
                                        BorderThickness="1">

                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock Text="{Binding}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"
                                               FontSize="12"/>

                                                <Button Width="18"
                                                Height="18"
                                                Padding="0"
                                                Margin="2,0,0,0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Style="{StaticResource FlatToolButton}"
                                                ToolTip="Remove characteristic"
                                                Tag="{Binding}"
                                                Click="RemoveCharacteristic_Click">

                                                    <materialDesign:PackIcon Kind="Close"
                                                 Width="12"
                                                 Height="12"
                                                 Opacity="0.7"/>

                                                </Button>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>
                        </ScrollViewer>
                        
                        <Grid Grid.Row="1" Grid.Column="1" Height="40">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="AddCharacteristicTextBox"
                                Height="22"
                                Margin="6,0,0,0"
                                FontSize="12"
                                KeyDown="AddCharacteristicTextBox_KeyDown"/>

                            <Button Grid.Column="1"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"                        
                                Margin="0,0,0,0"
                                Style="{StaticResource FlatToolButton}"
                                ToolTip="Add a characteristic."
                                Click="AddCharacteristic_Click">
                                        <materialDesign:PackIcon Kind="AddBold"
                                             Foreground="#FF45443F"
                                             HorizontalAlignment="Center"
                                             Width="20"
                                             Height="20"
                                             Opacity="0.7"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </GroupBox>



            </StackPanel>

        </Border>

        <StackPanel Grid.Row="2" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,10">

            <Button Content="Ok"
                    Command="{Binding CloseObjectCharacteristicsCommand}"
                    Style="{StaticResource FlatToolButton}"
                    Width="60"
                    Height="60"/>
        </StackPanel>

    </Grid>
</ui:ModalDialog>
