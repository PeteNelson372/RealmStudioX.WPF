 <ui:FloatingToolbar x:Class="RealmStudioX.WPF.Views.Dialogs.SelectionFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"        
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="true"
        Background="#FFCDC9C1"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Title="SelectionFilterDialog"
        Height="590"
        Width="34">

    <Border Background="#FFCDC9C1"
            BorderBrush="#888"
            BorderThickness="1"
            Height="590"
            Width="34">

        <StackPanel Orientation="Vertical" Margin="0,10,0,0"
                    HorizontalAlignment="Center">

            <Grid>
            
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearLandformFilterCommand}"
                    ToolTip="Landform Selection">
                    <materialDesign:PackIcon Kind="LandPlots"
                                 Width="20"
                                 Height="20"
                                 Foreground="SaddleBrown"
                                 Opacity="{Binding LandformSelectionAllowed,
                                    Converter={StaticResource BooleanToOpacityConverter}}"/>
                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding LandformSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>

            </Grid>

            <Grid>
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearWaterSystemFilterCommand}"
                    ToolTip="Water System Selection">
                    <materialDesign:PackIcon Kind="Watermill"
                             Width="20"
                             Height="20"
                             Opacity="{Binding WaterSystemSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"
                             Foreground="CadetBlue"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding WaterSystemSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>

            </Grid>

            <Grid>
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearLakeFilterCommand}"
                    ToolTip="Lake Selection">
                <materialDesign:PackIcon Kind="Lake"
                             Width="20"
                             Height="20"
                             Opacity="{Binding LakeSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"
                             Foreground="DarkSlateBlue"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding LakeSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>
                
            </Grid>

            <Grid>
                <Button Style="{StaticResource IconBarButtonStyle}"
                        Command="{Binding SetClearRiverFilterCommand}"
                        ToolTip="River Selection">
                    <materialDesign:PackIcon Kind="Waterfall"
                                 Width="20"
                                 Height="20"
                                 Opacity="{Binding RiverSelectionAllowed,
                                    Converter={StaticResource BooleanToOpacityConverter}}"                                             
                                 Foreground="CornflowerBlue"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding RiverSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>

            </Grid>

            <Grid>
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearPaintedWaterBodyFilterCommand}"
                    ToolTip="Painted Water Body Selection" HorizontalAlignment="Left" Width="32">
                    <materialDesign:PackIcon Kind="WaterCircle"
                             Width="20"
                             Height="20"
                             Opacity="{Binding PaintedWaterBodySelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"
                             Foreground="SlateBlue"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding PaintedWaterBodySelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>
                
            </Grid>

            <Grid>

                <Button Style="{StaticResource IconBarButtonStyle}"
                Command="{Binding SetClearPathFilterCommand}"
                ToolTip="Path Selection">
                    <materialDesign:PackIcon Kind="Road"
                             Width="20"
                             Height="20"
                             Opacity="{Binding PathSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"
                             Foreground="DarkSlateGray"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding PathSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>
                
            </Grid>

            <Grid>

                <Button Style="{StaticResource IconBarButtonStyle}"
                Command="{Binding SetClearLabelFilterCommand}"
                ToolTip="Label Selection">
                    <materialDesign:PackIcon Kind="AlphabetLatin"
                             Width="20"
                             Height="20"
                             Opacity="{Binding LabelSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"
                             Foreground="Black"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding LabelSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>

            </Grid>

            <Grid>
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearBoxFilterCommand}"
                    ToolTip="Placed Box Selection">
                    <materialDesign:PackIcon Kind="SquareOutline"
                                 Width="20"
                                 Height="20"
                                 Opacity="{Binding BoxSelectionAllowed,
                                    Converter={StaticResource BooleanToOpacityConverter}}"
                                 Foreground="DarkOrchid"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding BoxSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>

            </Grid>

            <Grid>
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearRegionFilterCommand}"
                    ToolTip="Region Selection">
                    <materialDesign:PackIcon Kind="SurfaceArea"
                                 Width="20"
                                 Height="20"
                                 Opacity="{Binding RegionSelectionAllowed,
                                    Converter={StaticResource BooleanToOpacityConverter}}"
                                 Foreground="RoyalBlue"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding RegionSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>

            </Grid>

            <Grid>
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearDrawnShapeFilterCommand}"
                    ToolTip="Drawn Shape Selection">
                    <materialDesign:PackIcon Kind="StarBoxOutline"
                                 Width="20"
                                 Height="20"
                                 Opacity="{Binding DrawnShapeSelectionAllowed,
                                    Converter={StaticResource BooleanToOpacityConverter}}"
                                 Foreground="IndianRed"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding DrawnShapeSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>                
                
            </Grid>

            <Separator/>

            <Grid>
            
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearAllSymbolsFilterCommand}"
                    ToolTip="All Symbols Selection">
                    <materialDesign:PackIcon Kind="Image"
                                 Width="20"
                                 Height="20"
                                 Opacity="{Binding SymbolSelectionAllowed,
                                    Converter={StaticResource BooleanToOpacityConverter}}"
                                 Foreground="ForestGreen"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding SymbolSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>

            </Grid>

            <Grid>
            
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearStructuresFilterCommand}"
                    ToolTip="Structures Selection">
                    <materialDesign:PackIcon Kind="Castle"
                                 Width="14"
                                 Height="14"
                                 Opacity="{Binding StructureSelectionAllowed,
                                    Converter={StaticResource BooleanToOpacityConverter}}"
                                 Foreground="DarkSlateBlue"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="14"
                             Height="14"
                             Margin="3,0,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding StructureSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>

            </Grid>

            <Grid>
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearVegetationFilterCommand}"
                    ToolTip="Vegetation Selection">
                    <materialDesign:PackIcon Kind="PineTreeVariant"
                                 Width="14"
                                 Height="14"
                                 Opacity="{Binding VegetationSelectionAllowed,
                                    Converter={StaticResource BooleanToOpacityConverter}}"
                                 Foreground="DarkGreen"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="14"
                             Height="14"
                             Margin="3,0,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding VegetationSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>
            </Grid>

            <Grid>
            <Button Style="{StaticResource IconBarButtonStyle}"
                Command="{Binding SetClearTerrainFilterCommand}"
                ToolTip="Terrain Symbol Selection">
                <materialDesign:PackIcon Kind="Terrain"
                             Width="14"
                             Height="14"
                             Opacity="{Binding TerrainSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"
                             Foreground="DarkSlateBlue"/>

            </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="14"
                             Height="14"
                             Margin="3,0,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding TerrainSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>
                
            </Grid>

            <Grid>
                <Button Style="{StaticResource IconBarButtonStyle}"
                    Command="{Binding SetClearMarkerFilterCommand}"
                    ToolTip="Marker Selection">
                    <materialDesign:PackIcon Kind="AddressMarker"
                                 Width="14"
                                 Height="14"
                                 Opacity="{Binding MarkerSelectionAllowed,
                                    Converter={StaticResource BooleanToOpacityConverter}}"
                                 Foreground="DarkMagenta"/>

                </Button>

                <materialDesign:PackIcon Kind="CheckBold"
                             Width="14"
                             Height="14"
                             Margin="3,0,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="LightGreen"
                             Opacity="{Binding MarkerSelectionAllowed,
                                Converter={StaticResource BooleanToOpacityConverter}}"/>
                
            </Grid>

            <Separator/>

            <Button Style="{StaticResource IconBarButtonStyle}"
                Command="{Binding ClearFilterCommand}"
                ToolTip="Clear All Filters"
                Margin="0,10,0,0">
                <materialDesign:PackIcon Kind="FilterOffOutline"
                             Width="22"
                             Height="22"
                             Foreground="DarkGreen"/>
            </Button>

            <Button Style="{StaticResource IconBarButtonStyle}"
                Command="{Binding FilterAllCommand}"
                ToolTip="Set All Filters"
                Margin="0,10,0,0">
                <materialDesign:PackIcon Kind="FilterPlusOutline"
                             Width="22"
                             Height="22"
                             Foreground="DarkBlue"/>
            </Button>
        </StackPanel>
    </Border>
</ui:FloatingToolbar>
