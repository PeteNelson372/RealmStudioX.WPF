<ui:ModalDialog x:Class="RealmStudioX.WPF.Views.Dialogs.NameGenConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Dialogs"
        xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"        
        mc:Ignorable="d"
        Background="#FF45443F"
        WindowStyle="None"        
        Title="NameGenConfig" Height="470" Width="520">

    <!-- WindowChrome -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- ========================= -->
        <!-- CUSTOM TITLE BAR -->
        <!-- ========================= -->
        <Border Grid.Row="0"
            Grid.ColumnSpan="3"
            Background="#FF45443F">

            <controls:NameGenTitleBar />

        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Vertical" Margin="15,0,0,0">

            <TextBlock Text="Name Generators"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="DemiBold"
                        Margin="12,12,3,3"/>

            <CheckBox Content="Select All"
                              Margin="10,3,3,0"
                              IsChecked="{Binding AllNameGeneratorsSelected}"/>

            <ListBox x:Name="NameGeneratorList"
                     Width="150"
                     Height="130"
                     Margin="3,3,3,3"
                     ItemsSource="{Binding NameGenerators}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding NameGeneratorName}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <TextBlock Text="Name Bases"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="DemiBold"
                        Margin="10,30,3,3"/>

            <CheckBox Content="Select All"
                              Margin="10,3,3,0"
                              IsChecked="{Binding AllNameBasesSelected}"/>

            <ListBox x:Name="NameBaseList"
                     Width="150"
                     Height="150"
                     Margin="3,3,3,3"
                     ItemsSource="{Binding NameBases}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding NameBaseName}"
                                IsChecked="{Binding IsNameBaseSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="15,0,0,0">

            <TextBlock Text="Languages"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="DemiBold"
                        Margin="12,12,3,3"/>

            <CheckBox Content="Select All"
                    Margin="10,3,3,0"
                    IsChecked="{Binding AllLanguagesSelected}"/>

            <ListBox x:Name="LanguageList"
                     Width="150"
                     Height="355"
                     Margin="3,3,3,3"
                     ItemsSource="{Binding NameLanguages}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Language}"
                                IsChecked="{Binding IsLanguageSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical" Margin="0,28,0,0">

            <Button Width="26"
                    Height="26"
                    HorizontalAlignment="Right"
                    Margin="3,0,15,0"
                    ToolTip="Clear Generated Names"
                    Style="{StaticResource FlatToolButton}"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding ClearNamesCommand}">

                <materialDesign:PackIcon
                    Width="20"
                    Height="20"
                    Opacity="0.7"
                    Kind="GarbageCan">
                </materialDesign:PackIcon>
            </Button>

            <Button
                x:Name="GeneratNamesButton"
                Style="{StaticResource FlatToolButton}"
                Width="140"
                Height="50"
                Margin="3,3,3,3"
                Background="GhostWhite"
                ToolTip="Select Font"
                Command="{Binding GenerateNamesCommand}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>
                    <materialDesign:PackIcon
                        Width="32"
                        Height="32"
                        Opacity="0.7"
                        Foreground="#FFCAC7BF"
                        HorizontalAlignment="Center"
                        Kind="MagicWand" Grid.RowSpan="2"/>

                    <TextBlock Text="Generate Names"
                                   FontSize="12"
                                   Foreground="#FF45443F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,4,0,0" Grid.Row="1"/>
                </Grid>
            </Button>

            <ListBox x:Name="GeneratedNames"
                     Width="140"
                     Height="220"
                     Margin="3,3,3,3"
                     ItemsSource="{Binding GeneratedNames}"
                     SelectedItem="{Binding SelectedGeneratedName}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border"
                                                        Background="Transparent"
                                                        Padding="{TemplateBinding Padding}">

                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <!-- Selected -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border"
                                                                Property="Background"
                                                                Value="#FF99B0A4"/>
                                            <Setter Property="Foreground"
                                                                Value="White"/>
                                        </Trigger>

                                        <!-- Hover (unselected) -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border"
                                                                Property="Background"
                                                                Value="#DDDDDD"/>
                                        </Trigger>

                                        <!-- Optional: hovered + selected -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Border"
                                                                Property="Background"
                                                                Value="#88a99c"/>
                                        </MultiTrigger>

                                        <!-- Disabled -->
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>

                </Grid.ColumnDefinitions>
                <Button
                        Grid.Column="2"
                        x:Name="CloseButton"
                        Style="{StaticResource FlatToolButton}"
                        Width="45"
                        Height="45"
                        Margin="3,3,3,3"
                        ToolTip="Close"
                        Click="Close_Click">

                    <TextBlock Text="Close"
                                FontSize="12"
                                Foreground="#FF45443F"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,0"/>

                </Button>

                <Button
                    Grid.Column="1"
                    x:Name="ApplyButton"
                    Style="{StaticResource FlatToolButton}"
                    Width="45"
                    Height="45"
                    Margin="3,3,3,3"
                    ToolTip="Apply"
                    Command="{Binding ApplyGeneratedNameCommand}">

                    <TextBlock Text="Apply"
                                FontSize="12"
                                Foreground="#FF45443F"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,0"/>

                </Button>
                <Button
                x:Name="ClipboardButton"
                Style="{StaticResource FlatToolButton}"
                Width="45"
                Height="45"
                Margin="3,3,3,3"
                ToolTip="Copy to Clipboard"
                Command="{Binding CopyGeneratedNamesCommand}">
                    <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Opacity="0.7"
                            Foreground="#FF45443F"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="ClipboardAdd">
                    </materialDesign:PackIcon>
                </Button>
            </Grid>

        </StackPanel>
    </Grid>
</ui:ModalDialog>
