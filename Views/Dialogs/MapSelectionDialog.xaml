<Window x:Class="RealmStudioX.WPF.Views.Dialogs.MapSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:RealmStudioX.WPF.Views"
        xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
        xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
        xmlns:vm="clr-namespace:RealmStudioX.WPF.ViewModels.Dialogs"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Select Project Map"
        Width="340"
        Height="570"
        MinWidth="300"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFDFDBD2">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="#FFDFDBD2"
            BorderBrush="#FF45443F"
            BorderThickness="6"
            CornerRadius="2">

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>


            <TextBlock Grid.Row="0"
                       Text="Select Map"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Background="#FF45443F"
                       Foreground="#E5E5E5"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       Height="30"
                       Padding="20,0,0,0"
                       Margin="0,0,0,0"/>

            <Grid Grid.Row="1">
                <ListBox x:Name="MapList"
                     ItemsSource="{Binding MapTiles}"
                     SelectionChanged="MapList_SelectionChanged"
                     MouseDoubleClick="MapList_MouseDoubleClick"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TileBorder"
                                            Background="#FFF2EDE4"
                                            BorderBrush="#FFCCCCCC"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="4">

                                            <ContentPresenter/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                 Value="True">
                                                <Setter TargetName="TileBorder"
                                                    Property="Background"
                                                    Value="#FFDDDDDD"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected"
                                                 Value="True">
                                                <Setter TargetName="TileBorder"
                                                    Property="Background"
                                                    Value="#FF99B0A4"/>
                                                <Setter TargetName="TileBorder"
                                                    Property="BorderBrush"
                                                    Value="#FF708D7E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="90"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                    Background="#FFE5E0D7"
                                    CornerRadius="2"
                                    ClipToBounds="True">

                                    <Image Source="{Binding PreviewImage}"
                                       Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Row="1"
                                        Margin="5,5,5,3">

                                    <TextBlock Text="{Binding MapName}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="#FF353535"
                                           TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding RealmType}"
                                           FontSize="11"
                                           Foreground="#FF555555"/>

                                    <TextBlock Text="{Binding Dimensions}"
                                           FontSize="10"
                                           Foreground="#FF777777"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="NoMapsText"
                       Text="There are no maps in the current project."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="#FF666666"
                       Visibility="Collapsed"/>
            </Grid>

            <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,10,10">

                <Button x:Name="SelectButton"
                    Content="Select"
                    Width="95"
                    Height="30"
                    Margin="0,0,12,0"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Select_Click">

                    <Button.Style>

                        <Style TargetType="Button">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="0">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Border"
                                                    Property="Opacity"
                                                    Value="0.5"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="Background"
                                    Value="#8A9EA0"/>

                            <Setter Property="Foreground"
                                    Value="White"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsDestructive}"
                                             Value="True">

                                    <Setter Property="Background"
                                            Value="#C65A5A"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>

                </Button>

                <Button Content="Cancel"
                    Width="95"
                    Height="30"
                    Margin="0,0,0,0"
                    IsCancel="True">

                    <Button.Style>


                        <Style TargetType="Button">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="0">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </Button.Style>

                </Button>


            </StackPanel>
        </Grid>
    </Border>
</Window>

    
    