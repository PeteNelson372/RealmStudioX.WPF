<ui:ModalDialog  x:Class="RealmStudioX.WPF.Views.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Dialogs"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"             
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
        xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
        xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
        xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"                 
        Title="Export Dialog" Height="280" Width="500">
    
    <Border Background="#FFDFDBD2"
            BorderBrush="#FF45443F"
            BorderThickness="6"
            CornerRadius="2">

        <Grid Margin="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->

            <TextBlock Grid.Row="0"
                       Text="Export Realm"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Background="#FF45443F"
                       Foreground="#E5E5E5"
                       VerticalAlignment="Center"
                       Height="26"
                       Padding="20,0,0,0"
                       Margin="0,0,0,0"/>

            <!-- Content -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Export Realm As..." Margin="10,10,10,10">
                    <StackPanel
                        Orientation="Vertical"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Height="Auto"
                        Margin="3,3,3,3">

                        <RadioButton Content="Image" GroupName="ExportType"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportType,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmExportType.BitmapImage}}"/>

                        <RadioButton Content="Upscaled Image (2X)" GroupName="ExportType"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportType,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmExportType.UpscaledImage}}"/>

                        <RadioButton Content="Map Layers" GroupName="ExportType"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportType,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmExportType.MapLayers}}"/>

                        <RadioButton Content="Grayscale Height Map" GroupName="ExportType"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportType,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmExportType.Heightmap}}"/>

                        <RadioButton Content="Height Map 3D Model" GroupName="ExportType"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportType,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmExportType.HeightMap3DModel}}"/>

                        <RadioButton Content="Realm Studio Map XML (.rsmx)" GroupName="ExportType"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportType,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmExportType.RealmStudioMapXml}}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Export Format" Margin="10,10,10,10">
                    <StackPanel
                        Orientation="Vertical"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Height="Auto"
                        Margin="3,3,3,3">

                        <RadioButton Content="PNG File (.png)" GroupName="ExportFormat"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportFormat,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmMapExportFormat.PNG}}"/>

                        <RadioButton Content="JPEG File (.jpg)" GroupName="ExportFormat"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportFormat,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmMapExportFormat.JPG}}"/>

                        <RadioButton Content="BMP File (.bmp)" GroupName="ExportFormat"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportFormat,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmMapExportFormat.BMP}}"/>

                        <RadioButton Content="GIF File (.gif)" GroupName="ExportFormat"
                            Margin="10,3,3,3"
                            IsChecked="{Binding RealmExportFormat,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:RealmMapExportFormat.GIF}}"/>


                    </StackPanel>
                </GroupBox>

            </Grid>

            <!-- Buttons -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,10">

                <Button Width="95"
                        Height="30"
                        Margin="0,0,12,0"
                        Content="Export"
                        IsDefault="True"
                        Command="{Binding ExportRealmCommand}">

                    <Button.Style>

                        <Style TargetType="Button">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="0">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Border"
                                                    Property="Opacity"
                                                    Value="0.5"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="Background"
                                    Value="#8A9EA0"/>

                            <Setter Property="Foreground"
                                    Value="White"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsDestructive}"
                                             Value="True">

                                    <Setter Property="Background"
                                            Value="#C65A5A"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>

                </Button>

                <Button Width="95"
                        Height="30"
                        Margin="0,0,12,0"
                        Content="Cancel"
                        IsCancel="True">

                    <Button.Style>


                        <Style TargetType="Button">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="0">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </Button.Style>
                </Button>

            </StackPanel>

        </Grid>

    </Border>
</ui:ModalDialog>
