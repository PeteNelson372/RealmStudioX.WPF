<ui:ModalDialog x:Class="RealmStudioX.WPF.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:RealmStudioX.WPF.Views"
        xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
        xmlns:vm="clr-namespace:RealmStudioX.WPF.ViewModels.Dialogs"
        mc:Ignorable="d"
        Title="About Dialog"
        Width="650"
        Height="700"
        MinWidth="650"
        MaxWidth="650"
        MinHeight="700"
        MaxHeight="700"
        Background="#FF45443F"
        WindowStyle="None"
        ResizeMode="NoResize"
        Icon="../../Assets/ico/realm_studio_icon.ico">

    <Window.Resources>
        <ScaleTransform x:Key="RadioScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
    </Window.Resources>

    <!-- WindowChrome -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="10" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Main -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
            Grid.ColumnSpan="3"
            Background="#FF45443F">

            <TextBlock Text="About RealmStudioX"
                       Foreground="#E5E5E5"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Width="Auto" HorizontalAlignment="Left" Margin="10,10,0,0">
                    <Image Width="127" Height="100"
                           HorizontalAlignment="Left"
                           Stretch="Fill"
                           Source="/Assets/png/ZeroSum white - no background.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"/>
                    
                    <Image
                        Source="/Views/Dialogs/brookmonte-group-logo.png"
                        Width="127" Height="54"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        Stretch="Fill"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        Cursor="Hand"
                        Tag="https://www.brookmonte.com"
                        MouseLeftButtonUp="ImageLink_Click"/>

                    <TextBlock HorizontalAlignment="Left" Margin="10,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://www.brookmonte.com">
                            brookmonte.com
                        </Hyperlink>
                    </TextBlock>

                    <Image
                        Source="/Views/Dialogs/gplv3-127x51.png"
                        Width="127" Height="51"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Left"
                        Stretch="Fill"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        Cursor="Hand"
                        Tag="https://www.gnu.org/licenses/"
                        MouseLeftButtonUp="ImageLink_Click"/>

                    <Image
                        Source="/Views/Dialogs/GitHub_Logo.png"
                        Width="127" Height="51"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Left"
                        Stretch="Fill"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        Cursor="Hand"
                        Tag="https://github.com/"
                        MouseLeftButtonUp="ImageLink_Click"/>


                    <TextBlock HorizontalAlignment="Left" Margin="10,20,0,0" Text="RealmStudioX Source" FontWeight="Bold"/>

                    <TextBlock HorizontalAlignment="Left" Margin="15,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://github.com/PeteNelson372/RealmStudioX.WPF">
                            User Interface
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Left" Margin="15,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://github.com/PeteNelson372/RealmStudioShapeRenderingLib">
                            Shape Rendering
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Left" Margin="15,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://github.com/PeteNelson372/RealmStudioX.Core">
                            Core
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Left" Margin="15,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://github.com/PeteNelson372/RealmStudioX.Infrastructure">
                            Infrastructure
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Left" Margin="10,15,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://petenelson372.github.io/RealmStudioDocs/">
                            RealmStudioX Help
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Left" Margin="10,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://github.com/PeteNelson372/RealmStudio/blob/cfdc91a772a18d41ae010a224846b98dec8653fc/Resources/ReleaseNotes.txt">
                            Release Notes
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Left" Margin="10,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="mailto://support@brookmonte.com">
                            Email Support
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Left" Margin="10,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://brookmonte.com/downloadable/RealmStudio/RealmStudioPrivacyPolicy.txt">
                            RealmStudioX Privacy Policy
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Left" Margin="10,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://github.com/PeteNelson372/RealmStudio/releases/latest">
                            RealmStudioX on Github
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Left" Margin="10,5,0,0">
                        <Hyperlink Click="OpenLink_Click" NavigateUri="https://apps.microsoft.com/detail/xp8lcmjbk0zfxw?hl=en-US&amp;gl=US">
                            RealmStudioX on Microsoft Store
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>

                <StackPanel Grid.Column="1" Width="410" HorizontalAlignment="Left" Margin="10,10,0,0" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="555"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                            Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,10,0,0">

                            <Grid>
                                <TextBlock
                                    Text="Realm Studio"
                                    FontFamily="Copperplate Gothic Bold"
                                    FontSize="18"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Text="X"
                                    FontFamily="Copperplate Gothic Bold"
                                    FontSize="9.25"
                                    FontWeight="Bold"
                                    TextDecorations="Underline"
                                    Foreground="#970C10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="136,3,0,0"/>
                            </Grid>

                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="0,0,0,0" FontSize="10" FontWeight="Normal">
                                    <Run Text="Version "/>
                                    <Run Text="{Binding RealmStudioApp.Version, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="0,0,0,0" FontSize="10" FontWeight="Normal">
                                    <Run Text="Assembly "/>
                                    <Run Text="{Binding RealmStudioApp.AssemblyVersion, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="0,0,0,0" FontSize="10" FontWeight="Normal">
                                    <Run Text="Build Date "/>
                                    <Run Text="{Binding RealmStudioApp.BuildDateString, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="0,0,0,0" FontSize="10" FontWeight="Normal">
                                    <Run Text="The Brookmonte Group:"/>
                                    <Run Text="{Binding RealmStudioApp.CompanyName, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="0,3,0,3" FontSize="12" FontWeight="Bold">
                                    <Run Text="{Binding RealmStudioApp.Copyright, Mode=OneWay}" />
                            </TextBlock>

                            <GroupBox Header="Licensing Information" FontSize="16" Margin="0,0,0,0" Width="400" HorizontalAlignment="Left">
                                <ScrollViewer Height="175" MaxHeight="175"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        Margin="10">

                                    <TextBlock
                                        TextWrapping="Wrap"
                                        FontSize="12">

                                        <Run Text="Realm Studio X is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version."/>
                                        <LineBreak/>
                                        <LineBreak/>

                                        <Run Text="Realm Studio X is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details."/>
                                        <LineBreak/>
                                        <LineBreak/>

                                        <Run Text="You should have received a copy of the GNU General Public License along with this program. The text of the GNU General Public License (GPL) is found in the LICENSE.txt file. If the LICENSE.txt file is not present or the text of the GNU GPL is not present in the LICENSE.txt file, see "/>

                                        <Hyperlink
                                            NavigateUri="https://www.gnu.org/licenses/"
                                            Click="OpenLink_Click">
                                            <Run Text="https://www.gnu.org/licenses/"/>
                                        </Hyperlink>

                                        <Run Text="."/>
                                        <LineBreak/>
                                        <LineBreak/>

                                        <Run Text="For questions about the Realm Studio X application or about licensing, please email "/>

                                        <Hyperlink
                                            NavigateUri="mailto:support@brookmonte.com"
                                            Click="OpenLink_Click">
                                            <Run Text="support@brookmonte.com"/>
                                        </Hyperlink>

                                        <Run Text="."/>

                                    </TextBlock>

                                </ScrollViewer>
                            </GroupBox>

                            <GroupBox Header="Information and Credits" FontSize="16" Margin="0,10,0,0" Width="400" HorizontalAlignment="Left">

                                <ScrollViewer Height="175" MaxHeight="175"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    Margin="0">
                                    
                                    <TextBlock
                                    Padding="5"
                                    TextWrapping="Wrap"
                                    FontSize="12">

                                    <Run Text="Links to source code for Realm Studio X are on the left side of this window."/>
                                    <LineBreak/>
                                    <LineBreak/>

                                    <Run Text="Realm Studio X uses the SkiaSharp ("/>
                                    <Hyperlink
                                        NavigateUri="https://github.com/mono/SkiaSharp"
                                        Click="OpenLink_Click">
                                        <Run Text="https://github.com/mono/SkiaSharp"/>
                                    </Hyperlink>
                                    <Run Text=") implementation of the Google Skia ("/>
                                    <Hyperlink
                                        NavigateUri="https://skia.org/"
                                        Click="OpenLink_Click">
                                        <Run Text="https://skia.org/"/>
                                    </Hyperlink>
                                    <Run Text=") graphics library for rendering graphics."/>
                                    <LineBreak/>
                                    <LineBreak/>

                                    <Run Text="Realm Studio X also uses libraries from:"/>
                                    <LineBreak/>

                                    <Run Text="Clipper2 ("/>
                                    <Hyperlink
                                        NavigateUri="https://www.angusj.com/clipper2/Docs/Overview.htm"
                                        Click="OpenLink_Click">
                                        <Run Text="https://www.angusj.com/clipper2/Docs/Overview.htm"/>
                                    </Hyperlink>
                                    <Run Text=")"/>
                                    <LineBreak/>

                                    <Run Text="Helix Toolkit ("/>
                                    <Hyperlink
                                        NavigateUri="https://github.com/helix-toolkit/helix-toolkit"
                                        Click="OpenLink_Click">
                                        <Run Text="https://github.com/helix-toolkit/helix-toolkit"/>
                                    </Hyperlink>
                                    <Run Text=")"/>
                                    <LineBreak/>

                                    <Run Text="log4net by the Apache Software Foundation ("/>
                                    <Hyperlink
                                        NavigateUri="https://logging.apache.org/log4net/"
                                        Click="OpenLink_Click">
                                        <Run Text="https://logging.apache.org/log4net/"/>
                                    </Hyperlink>
                                    <Run Text=")"/>
                                    <LineBreak/>
                                    <LineBreak/>

                                    <Run Text="Several other libraries are included as transitive packages (packages that are used by the libraries that are used directly). See the project pages for the libraries for their acknowledgements."/>
                                    <LineBreak/>
                                    <LineBreak/>

                                    <Run Text="Embedded fonts (those not installed on your computer) are redistributed and licensed under the SIL Open Font License. See "/>
                                    <Hyperlink
                                        NavigateUri="https://openfontlicense.org/open-font-license-official-text/"
                                        Click="OpenLink_Click">
                                        <Run Text="https://openfontlicense.org/open-font-license-official-text/"/>
                                    </Hyperlink>
                                    <Run Text="."/>
                                    <LineBreak/>
                                    <LineBreak/>

                                    <Run Text="Realm Studio X uses image assets from SVG Repo ("/>
                                    <Hyperlink
                                        NavigateUri="https://www.svgrepo.com/vectors/map-marker/"
                                        Click="OpenLink_Click">
                                        <Run Text="https://www.svgrepo.com/vectors/map-marker/"/>
                                    </Hyperlink>
                                    <Run Text="), Freepik (freepik.com), FreeImages (freeimages.com), and FlatIcon (flaticon.com). Credit is given to artists:"/>
                                    <LineBreak/>

                                    <Run Text="efe_madrid, kjpargeter, Layerace, rawpixel (rawpixel.com), jvror, and Vector Stall ("/>
                                    <Hyperlink
                                        NavigateUri="https://www.flaticon.com/authors/vector-stall"
                                        Click="OpenLink_Click">
                                        <Run Text="https://www.flaticon.com/authors/vector-stall"/>
                                    </Hyperlink>
                                    <Run Text=")."/>
                                    <LineBreak/>
                                    <LineBreak/>

                                    <Run Text="Planet textures are from various free and open sources, including"/>
                                    <LineBreak/>

                                    <Run Text=" - Solar System Scope ("/>
                                    <Hyperlink
                                        NavigateUri="https://www.solarsystemscope.com/textures/"
                                        Click="OpenLink_Click">
                                        <Run Text="https://www.solarsystemscope.com/textures/"/>
                                    </Hyperlink>
                                    <Run Text=")."/>
                                    <LineBreak/>

                                    <Run Text=" - NASA JPL ("/>
                                    <Hyperlink
                                        NavigateUri="https://nasa3d.arc.nasa.gov/contributor?id=35"
                                        Click="OpenLink_Click">
                                        <Run Text="https://nasa3d.arc.nasa.gov/contributor?id=35"/>
                                    </Hyperlink>
                                    <Run Text=")."/>
                                    <LineBreak/>

                                    <Run Text=" - DeviantArt, specifically"/>
                                    <LineBreak/>

                                    <Run Text="     - Oleg Pluton: ("/>
                                    <Hyperlink
                                        NavigateUri="https://www.deviantart.com/oleg-pluton/art/Deimos-texture-map-Upd-2024-772205702"
                                        Click="OpenLink_Click">
                                        <Run Text="https://www.deviantart.com/oleg-pluton/art/Deimos-texture-map-Upd-2024-772205702"/>
                                    </Hyperlink>
                                    <Run Text=")"/>
                                    <LineBreak/>

                                    <Run Text="     - Duc Nguyen ("/>
                                    <Hyperlink
                                        NavigateUri="https://www.deviantart.com/ducn1567/art/Europa-Texture-2K-1014817839"
                                        Click="OpenLink_Click">
                                        <Run Text="https://www.deviantart.com/ducn1567/art/Europa-Texture-2K-1014817839"/>
                                    </Hyperlink>
                                    <Run Text=")"/>
                                    <LineBreak/>
                                    <LineBreak/>

                                    <Run Text="Realm Studio X also uses Wonderdraft assets imported from CartographyAssets ("/>
                                    <Hyperlink
                                        NavigateUri="https://cartographyassets.com"
                                        Click="OpenLink_Click">
                                        <Run Text="https://cartographyassets.com"/>
                                    </Hyperlink>
                                    <Run Text="). See the Help file for information on importing assets into Realm Studio X."/>

                                    </TextBlock>

                                </ScrollViewer>
                            </GroupBox>

                        </StackPanel>

                        <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,0">

                            <Button Content="Close"
                                Style="{StaticResource FlatToolButton}"
                                Width="60"
                                Height="60"
                                Click="Close_Click"/>
                        </StackPanel>
                        
                    </Grid>




                </StackPanel>


            </Grid>
        </StackPanel>

    </Grid>
</ui:ModalDialog>
