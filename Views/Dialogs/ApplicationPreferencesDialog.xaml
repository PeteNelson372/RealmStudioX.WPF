<ui:ModalDialog x:Class="RealmStudioX.WPF.Views.Dialogs.ApplicationPreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:RealmStudioX.WPF.Views"
        xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"                
        xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
        xmlns:vm="clr-namespace:RealmStudioX.WPF.ViewModels.Dialogs"
        mc:Ignorable="d"
        Title="Application Preferences"
        Width="700"
        Height="520"
        MinWidth="700"
        MaxWidth="700"
        MinHeight="520"
        MaxHeight="520"
        Background="#FF45443F"
        WindowStyle="None"
        ResizeMode="NoResize"
        Icon="../../Assets/ico/realm_studio_icon.ico">

    <Window.Resources>
        <ScaleTransform x:Key="RadioScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
    </Window.Resources>

    <!-- WindowChrome -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="10" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Main -->
        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- CUSTOM TITLE BAR -->
        <!-- ========================= -->
        <Border Grid.Row="0"
            Background="#FF45443F">

            <TextBlock Text="Application Preferences"
                       Foreground="#E5E5E5"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

        </Border>

        <StackPanel Grid.Row="1">


            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Default Realm Directory"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Grid.Column="1"
                         Padding="4"
                         Margin="0,0,0,0"
                         Text="{Binding RootRealmsDirectory,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Default Measurement Units"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <ComboBox x:Name="UnitsCombo"
                          Grid.Column="1"
                          Width="150"
                          Margin="0,0,0,6"
                          HorizontalAlignment="Left"
                          Background="#FFDFDBD2"
                          ItemsSource="{Binding MeasurementUnits}"
                          SelectedItem="{Binding DefaultMeasurementUnits, Mode=TwoWay}" />

                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Realm Asset Directory"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Grid.Column="1"
                         Padding="4"
                         Margin="0,0,0,0"
                         Text="{Binding RootAssetDirectory,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Autosave Realm Project"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <CheckBox x:Name="AutosaveToggle" Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="{Binding AutoSaveEnabled, Mode=TwoWay}"
                        Style="{StaticResource ToggleSwitchStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                </Grid>
            </StackPanel>
                        
            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Default Autosave Directory"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Grid.Column="1"
                         Padding="4"
                         Margin="0,0,0,0"
                         Text="{Binding AutosaveDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Autosave Interval"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <Slider x:Name="AutosaveIntervalSlider" Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                    Width="450"
                                    TickPlacement="BottomRight"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    AutoToolTipPlacement="TopLeft"
                                    ToolTip="{Binding AutosaveInterval}"
                                    Minimum="{Binding MinSaveInterval}"
                                    Maximum="{Binding MaxSaveInterval}"
                                    Value="{Binding AutosaveInterval}"/>

                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Play Sound On Save"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <CheckBox x:Name="PlaySoundToggle" Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="{Binding PlaySoundEnabled, Mode=TwoWay}"
                        Style="{StaticResource ToggleSwitchStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Save Sound"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <ComboBox Grid.Column="1"
                          x:Name="SaveSoundFiles"
                          HorizontalAlignment="Left"
                          Background="#FFDFDBD2"
                          Width="200"
                          IsEditable="False"
                          SelectionChanged="SaveSound_SelectionChanged" Height="22" VerticalAlignment="Bottom" />

                    <Button Grid.Column="1"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        HorizontalAlignment="Left"
                        Margin="210,0,0,0"
                        Click="PlaySaveSoundClick" Width="32">

                        <materialDesign:PackIcon Kind="PlayCircle"
                                     Width="16"
                                     Height="16"
                                     Opacity="0.7"/>
                    </Button>

                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Default Export Format"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <ComboBox Grid.Column="1"
                          x:Name="ExportFormats"
                          HorizontalAlignment="Left"
                          Background="#FFDFDBD2"
                          Width="100"
                          IsEditable="False"
                          SelectionChanged="ExportFormats_SelectionChanged" />

                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Automatically Check for Updates"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <CheckBox x:Name="CheckUpdatesToggle" Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="{Binding CheckUpdatesEnabled, Mode=TwoWay}"
                        Style="{StaticResource ToggleSwitchStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,10,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="450" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Default Map Size"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           FontSize="12"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <ComboBox Grid.Column="1"
                      x:Name="PresetList"
                      Background="#FFDFDBD2"
                      Width="450"
                      DisplayMemberPath="Display"
                      IsEditable="False"
                      SelectionChanged="PresetList_SelectionChanged" />

                </Grid>
            </StackPanel>

            <!-- Close Button -->

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"  Margin="0,0,0,0" Grid.ColumnSpan="2">

                    <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,20,20,0">

                        <Button Content="Close"
                            Click="CloseButton_Click"
                            Style="{StaticResource FlatToolButton}"
                            Width="60"
                            Height="60"/>
                    </StackPanel>
                </StackPanel>

        </StackPanel>

    </Grid>
</ui:ModalDialog>
