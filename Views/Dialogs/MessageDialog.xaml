<Window x:Class="RealmStudioX.WPF.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Dialogs"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"             
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
        xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
        xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
        xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"
        xmlns:vm="clr-namespace:RealmStudioX.WPF.ViewModels.Dialogs"        
        mc:Ignorable="d"
        Width="450"
        Height="200"        
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    
    <Border Background="#FFDFDBD2"
            BorderBrush="#FF45443F"
            BorderThickness="6"
            CornerRadius="2">

        <Grid Margin="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->

            <TextBlock Grid.Row="0"
                       Text="{Binding DialogTitle}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Background="#FF45443F"
                       Foreground="#E5E5E5"
                       VerticalAlignment="Center"
                       Height="26"
                       Padding="20,0,0,0"
                       Margin="0,0,0,0"/>

            <!-- Content -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->

                <materialDesign:PackIcon Grid.Column="0"
                                         Kind="{Binding DialogIcon}"
                                         Width="28"
                                         Height="28"
                                         VerticalAlignment="Top"
                                         Margin="10,25,0,0"
                                         Foreground="{Binding IconBrush}"/>

                <!-- Message -->

                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Margin="0,30,0,0"
                           HorizontalAlignment="Center"
                           Width="350"
                           Foreground="#FF45443F"
                           VerticalAlignment="Top"/>

            </Grid>

            <!-- Buttons -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,10">

                <Button Width="95"
                        Height="30"
                        Margin="0,0,12,0"
                        Content="{Binding PrimaryButtonText}"
                        IsDefault="True"
                        Command="{Binding PrimaryCommand}">

                    <Button.Style>

                        
                        <Style TargetType="Button">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="0">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Border"
                                                    Property="Opacity"
                                                    Value="0.5"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="Background"
                                    Value="#8A9EA0"/>

                            <Setter Property="Foreground"
                                    Value="White"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsDestructive}"
                                             Value="True">

                                    <Setter Property="Background"
                                            Value="#C65A5A"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>

                </Button>

                <Button Width="95"
                        Height="30"
                        Margin="0,0,12,0"
                        Content="{Binding SecondaryButtonText}"
                        Visibility="{Binding SecondaryButtonVisibility}"
                        IsCancel="True"
                        Command="{Binding SecondaryCommand}">

                    <Button.Style>


                        <Style TargetType="Button">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="0">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </Button.Style>
                </Button>

                <Button Width="95"
                        Height="30"
                        Content="{Binding TertiaryButtonText}"
                        Visibility="{Binding TertiaryButtonVisibility}"
                        IsCancel="True"
                        Command="{Binding TertiaryCommand}">

                    <Button.Style>


                        <Style TargetType="Button">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="0">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FFDFDBD2"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </Button.Style>
                </Button>

            </StackPanel>

        </Grid>

    </Border>
</Window>
