<ui:ModelessDialog
    x:Class="RealmStudioX.WPF.Views.Dialogs.WorldGlobeViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
    xmlns:threeD="clr-namespace:RealmStudioX._3D.Views.Controls;assembly=RealmStudioX.3D"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Controls"
    xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
    xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
    xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"    
    mc:Ignorable="d"
    Title="World Globe Viewer"
    Width="1560"
    Height="920"
    MinWidth="1560"
    MinHeight="920"
    Background="#FF45443F"
    WindowStyle="None"
    ShowInTaskbar="True"
    ResizeMode="CanResize"
    Icon="pack://application:,,,/Assets/ico/realm_studio_icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            ResizeBorderThickness="5"
            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#FFDFDBD2">

        <Grid.RowDefinitions>
            <!-- Custom title bar -->
            <RowDefinition Height="48" />

            <!-- Main menu -->
            <RowDefinition Height="32" />

            <!-- Common commands -->
            <RowDefinition Height="40" />

            <!-- Workspace -->
            <RowDefinition Height="*" />

            <!-- Status bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- TITLE BAR                                             -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="0"
            Background="#FF45443F">

            <controls:WorldGlobeViewerTitleBar
                x:Name="WorldGlobeViewerTitleBar" Margin="10,0,10,0" />

        </Border>

        <!-- ===================================================== -->
        <!-- MENU                                                  -->
        <!-- ===================================================== -->

        <controls:WorldGlobeViewerMenu
            x:Name="WorldGlobeViewerMenu"
            IsEnabled="{Binding CanEditScene}"
            Grid.Row="1"
            Background="#FFDFDBD2"
            Foreground="{DynamicResource
                {x:Static SystemColors.ControlTextBrushKey}}"
            Height="32" />

        <!-- ===================================================== -->
        <!-- TOOLBAR                                               -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="2"
            IsEnabled="{Binding CanEditScene}"
            Background="#FFEAE7E1"
            BorderBrush="#FFCAC6BF"
            BorderThickness="0,0,0,1"
            Padding="6,4"
            Margin="0,0,0,0">

            <DockPanel LastChildFill="True">

                <StackPanel
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">

                    <Button
                        Style="{StaticResource FlatToolButton}"
                        Background="#FFEAE7E1"

                        Padding="12,4"
                        Margin="10,0,0,0"
                        ToolTip="Load a 3D model or scene">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileUploadOutline"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="0,0,3,0"
                                     Width="18"
                                     Height="18"
                                     Opacity="0.7"/>

                            <TextBlock Text="Load..."
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>

                        </StackPanel>
                    </Button>

                    <Button
                        Style="{StaticResource FlatToolButton}"
                        Background="#FFEAE7E1"
                        Padding="12,4"
                        Margin="12,0,8,0"
                        ToolTip="Save the current scene">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="0,0,3,0"
                                     Width="18"
                                     Height="18"
                                     Opacity="0.7"/>

                            <TextBlock Text="Save..."
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>

                        </StackPanel>
                    </Button>

                    <Separator
                        Width="1"
                        Margin="4,0"
                        Background="#FFBEBAB3" />

                    <Button
                        Style="{StaticResource FlatToolButton}"
                        Command="{Binding ResetCameraCommand}"
                        Background="#FFEAE7E1"
                        Padding="12,4"
                        Margin="12,0,8,0"
                        ToolTip="Reset the camera position and orientation">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HomeOutline"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="0,0,3,0"
                                     Width="18"
                                     Height="18"
                                     Opacity="0.7"/>

                            <TextBlock Text="Reset Camera"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>

                        </StackPanel>
                    </Button>

                    <Button
                        Command="{Binding ChangeAxisCommand}"
                        Style="{StaticResource FlatToolButton}"
                        Background="#FFEAE7E1"
                        Padding="12,4"
                        Margin="12,0,8,0"
                        ToolTip="Change the camera rotation axis">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Axis"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="0,0,3,0"
                                     Width="18"
                                     Height="18"
                                     Opacity="0.7"/>

                            <TextBlock Text="Change Axis"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>

                        </StackPanel>
                    </Button>

                    <Separator
                        Width="1"
                        Margin="8,0"
                        Background="#FFBEBAB3" />


                    <Button
                        Style="{StaticResource FlatToolButton}"
                        Background="#FFEAE7E1"
                        Padding="12,4"
                        Margin="12,0,8,0"
                        ToolTip="Capture the current viewport"
                        Command="{Binding CaptureImageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CameraOutline"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="0,0,3,0"
                                     Width="18"
                                     Height="18"
                                     Opacity="0.7"/>

                            <TextBlock Text="Capture Image..."
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>

                        </StackPanel>
                    </Button>

                </StackPanel>

                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Width="Auto"
                        Height="Auto"
                        Margin="0,0,10,0">

                        <CheckBox x:Name="EnableAnimationCheckBox"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsChecked="{Binding EnableAnimation, Mode=TwoWay}"
                            Style="{StaticResource ToggleSwitchStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <TextBlock Text="Enable Animation"
                            Foreground="#FF45443F"
                            VerticalAlignment="Center"
                            Margin="4,0,10,0"/>
                    </StackPanel>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ===================================================== -->
        <!-- MAIN WORKSPACE                                        -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="3"
            Margin="8">

            <Grid.ColumnDefinitions>
                <!-- Fixed-width Scene Explorer -->
                <ColumnDefinition Width="240" />

                <!-- Viewport and fixed recording panel -->
                <ColumnDefinition Width="*" />

                <!-- Fixed-width Properties panel -->
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- LEFT: SCENE EXPLORER                              -->
            <!-- ================================================= -->

            <Border
                Grid.Column="0"
                IsEnabled="{Binding CanEditScene}"
                Background="#FFEAE7E1"
                BorderBrush="#FFC8C4BD"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8">

                <DockPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Scene Explorer"
                            FontSize="15"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                    </Grid>

                    <TreeView x:Name="SceneTree"
                          Margin="0"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="SceneTree_SelectedItemChanged">

                        <TreeView.Resources>

                            <Style TargetType="{x:Type TreeViewItem}">

                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="#FF343434"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">

                                            <StackPanel>

                                                <!-- Item header -->
                                                <Border x:Name="ItemBorder"
                                                    Background="#FFEEEEEE"
                                                    BorderBrush="#FFCCCCCC"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="{TemplateBinding Margin}"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ContentPresenter x:Name="PART_Header"
                                                          Grid.Column="0"
                                                          ContentSource="Header"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Child items -->
                                                <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>

                                            </StackPanel>

                                            <ControlTemplate.Triggers>

                                                <!-- Hover -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="#FFDDDDDD"/>
                                                </Trigger>

                                                <!-- Selected: keep this after Hover -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                        Property="Background"
                                                        Value="#FF99B0A4"/>

                                                    <Setter TargetName="ItemBorder"
                                                        Property="BorderBrush"
                                                        Value="#FF7D9588"/>

                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>

                                                <!-- Disabled -->
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#FF999999"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                            </Style>

                        </TreeView.Resources>

                        <TreeViewItem IsExpanded="True" Margin="0,2,0,0" Tag="Starfield">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <materialDesign:PackIcon
                                        Kind="Stars"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground,
                                            RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>

                                    <TextBlock Text="Starfield"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>


                        <TreeViewItem IsExpanded="True" Margin="0,2,0,0" Tag="World">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <materialDesign:PackIcon
                                        Kind="World"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground,
                                            RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>

                                    <TextBlock Text="World"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>
                                </StackPanel>
                            </TreeViewItem.Header>

                            <!-- world children -->

                            <TreeViewItem IsExpanded="True" Margin="0,2,0,0" Tag="Surface">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <materialDesign:PackIcon
                                            Kind="SurfaceArea"
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>

                                        <TextBlock Text="Surface"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>

                            <TreeViewItem IsExpanded="True" Margin="0,2,0,0" Tag="Atmosphere">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <materialDesign:PackIcon
                                            Kind="Clouds"
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>

                                        <TextBlock Text="Atmosphere"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>

                            <TreeViewItem x:Name="WorldMoonTreeViewItem" IsExpanded="True" Margin="0,2,0,0" Tag="Moons">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <materialDesign:PackIcon
                                            Kind="MoonFull"
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>

                                        <TextBlock Text="Moons"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>

                        </TreeViewItem>

                        <TreeViewItem x:Name="WorldLocalStarTreeViewItem" IsExpanded="True" Margin="0,2,0,0" Tag="LocalStar">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <materialDesign:PackIcon
                                        Kind="StarburstOutline"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground,
                                            RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>

                                    <TextBlock Text="Local Star"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>
                                </StackPanel>
                            </TreeViewItem.Header>

                            <TreeViewItem x:Name="PlanetsTreeViewItem" IsExpanded="True" Margin="0,2,0,0" Tag="Planets">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <materialDesign:PackIcon
                                            Kind="AtomVariant"
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>

                                        <TextBlock Text="Planets"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>
                                    </StackPanel>
                                </TreeViewItem.Header>

                            </TreeViewItem>

                        </TreeViewItem>

                        <TreeViewItem IsExpanded="True" Margin="0,2,0,0" Tag="Lighting">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <materialDesign:PackIcon
                                        Kind="LightbulbGroup"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground,
                                            RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>

                                    <TextBlock Text="Lighting"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <TreeViewItem IsExpanded="True" Margin="0,2,0,0" Tag="Effects">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <materialDesign:PackIcon
                                        Kind="Video"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground,
                                            RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>

                                    <TextBlock Text="Effects"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground,
                                                RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                    </TreeView>

                </DockPanel>
            </Border>
            <!-- ================================================= -->
            <!-- CENTER: VIEWPORT AND TIMELINE                     -->
            <!-- ================================================= -->

            <Grid
                Grid.Column="1"
                Width="972"
                Height="738"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="5,0,5,0">

                <Grid.RowDefinitions>
                    <!-- Fixed 960 x 540 capture viewport, including its border -->
                    <RowDefinition Height="542" />

                    <!-- Permanently visible, fixed-height recording panel -->
                    <RowDefinition Height="240" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Width="962"
                    Height="542"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding CanEditScene}"
                    Background="#FFF5F3EF"
                    BorderBrush="#FFC8C4BD"
                    BorderThickness="1"
                    Padding="0">

                    <threeD:ModelViewerControl
                        x:Name="ModelViewer"
                        Width="960"
                        Height="540"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0" />

                </Border>

                <!-- ============================================= -->
                <!-- ANIMATION TIMELINE                            -->
                <!-- ============================================= -->


                <Border
                    Grid.Row="1"
                    Width="962"
                    Height="190"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Background="#FFF5F3EF"
                    BorderBrush="#FFC8C4BD"
                    BorderThickness="1"
                    Padding="8">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Recording controls -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="540"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Recording -->
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,6">

                                <!-- Keep your existing Record Video button here -->

                                <Button
                                    Command="{Binding RecordVideoCommand}"
                                    Style="{StaticResource FlatToolButton}"
                                    Background="#FFEAE7E1"
                                    Width="120"
                                    Padding="12,4"
                                    Margin="0,0,20,0"
                                    ToolTip="Start or stop video recording">

                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            VerticalAlignment="Center"
                                            Margin="0,0,5,0"
                                            Width="20"
                                            Height="24"
                                            Opacity="0.7">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Kind" Value="Video"/>
                                                    <Setter Property="Foreground" Value="Green"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                            <Setter Property="Kind" Value="StopCircle"/>
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <TextBlock
                                            Text="{Binding RecordVideoButtonText}"
                                            FontSize="12"
                                            Foreground="#FF45443F"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock
                                    Text="Frame:"
                                    VerticalAlignment="Center"
                                    Margin="12,0,6,0"/>

                                <TextBlock
                                    Text="{Binding RecordedFramesDisplay}"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="Time:"
                                    VerticalAlignment="Center"
                                    Margin="15,0,6,0"/>

                                <TextBlock
                                    Text="{Binding AnimationTime, StringFormat='00:00.000'}"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="Elapsed:"
                                    VerticalAlignment="Center"
                                    Margin="15,0,6,0"/>

                                <TextBlock
                                    Text="{Binding ElapsedRecordingTime}"
                                    VerticalAlignment="Center"/>
                                
                            </StackPanel>

                            <!-- Recording settings -->
                            <StackPanel
                                Grid.Column="1"
                                IsEnabled="{Binding CanEditScene}"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,4,6">

                                <TextBlock
                                    Text="Frame Rate"
                                    VerticalAlignment="Center"
                                    Margin="8,0,6,0"/>

                                <ComboBox
                                    x:Name="FrameRateCombo"
                                    Width="75"
                                    Height="26"
                                    Background="#FFDFDBD2"
                                    ItemsSource="{Binding SupportedFrameRates}"
                                    SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}"/>

                                <TextBlock
                                    Text="Duration"
                                    VerticalAlignment="Center"
                                    Margin="10,0,6,0"/>

                                <controls:NumericUpDown
                                    x:Name="RecordingDurationBox"
                                    Foreground="Black"
                                    Background="#FFF5F3EF"
                                    VerticalAlignment="Center"
                                    Value="{Binding RecordingDurationSeconds}"
                                    Width="65"
                                    Height="24"/>
                            </StackPanel>
                        </Grid>

                        <!-- Capture statistics -->
                        <Border
                            Grid.Row="1"
                            Background="#FFF0EEE9"
                            BorderBrush="#FFD0CCC5"
                            BorderThickness="1"
                            Padding="6,3"
                            Margin="0,0,0,5">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                                    <TextBlock
                                        Text="Frame Time:"
                                        Foreground="#FF77736D"
                                        Margin="0,0,6,0"/>

                                    <TextBlock
                                        Text="{Binding FrameTimeDisplay}"
                                        FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                                    <TextBlock
                                        Text="Capture Rate:"
                                        Foreground="#FF77736D"
                                        Margin="0,0,6,0"/>

                                    <TextBlock
                                        Text="{Binding CaptureRateDisplay}"
                                        FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                                    <TextBlock
                                        Text="Estimated Remaining:"
                                        Foreground="#FF77736D"
                                        Margin="0,0,6,0"/>

                                    <TextBlock
                                        Text="{Binding RemainingTimeDisplay}"
                                        FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Thumbnail filmstrip -->
                        <Border
                            Grid.Row="2"
                            MinHeight="65"
                            Width="944"
                            Background="#FFEAE7E1"
                            BorderBrush="#FFD0CCC5"
                            BorderThickness="1"
                            Padding="6,3">

                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                CanContentScroll="True">

                                <ItemsControl ItemsSource="{Binding RecordingThumbnails}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Width="80"
                                                Margin="0,0,5,0">

                                                <Border
                                                    BorderBrush="#FFBDB8AF"
                                                    BorderThickness="1"
                                                    Background="#FFD5D1C9"
                                                    Padding="1">

                                                    <Image
                                                        Source="{Binding Image}"
                                                        Width="100"
                                                        Height="56"
                                                        Stretch="Uniform"/>
                                                </Border>

                                                <TextBlock
                                                    Text="{Binding TimeLabel}"
                                                    FontSize="9"
                                                    Foreground="#FF77736D"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>


            </Grid>

            <!-- ================================================= -->
            <!-- RIGHT: PROPERTIES                                 -->
            <!-- ================================================= -->

            <Border
                Grid.Column="2"
                IsEnabled="{Binding CanEditScene}"
                Background="#FFEAE7E1"
                BorderBrush="#FFC8C4BD"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8">

                <DockPanel x:Name="ToolsPanel">
                    <!-- Tool panels -->
                    <ContentControl x:Name="ToolsPanelHost"
                        Grid.Row="0"
                        Background="WhiteSmoke"/>
                </DockPanel>

            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- STATUS BAR                                            -->
        <!-- ===================================================== -->

        <StatusBar
            x:Name="ViewerStatusBar"
            Grid.Row="4"
            Background="#FF45443F"
            Foreground="White">

            <StatusBarItem
                HorizontalAlignment="Stretch"
                Foreground="WhiteSmoke">

                <TextBlock
                    Text="{Binding StatusMessage}"
                    Margin="6,0" />

            </StatusBarItem>

        </StatusBar>

    </Grid>

</ui:ModelessDialog>