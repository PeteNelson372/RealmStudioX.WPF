<ui:ModalDialog x:Class="RealmStudioX.WPF.Views.Dialogs.ResizeMapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:RealmStudioX.WPF.Views"
        xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
        xmlns:vm="clr-namespace:RealmStudioX.WPF.ViewModels.Dialogs"
        mc:Ignorable="d"
        Title="Resize Map"
        Width="550"
        Height="590"
        MinWidth="550"
        MaxWidth="550"
        MinHeight="590"
        MaxHeight="590"
        Background="#FF45443F"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="../../Assets/ico/realm_studio_icon.ico">

    <Window.Resources>
        <ScaleTransform x:Key="RadioScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
    </Window.Resources>

    <!-- WindowChrome -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="10" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Custom Title Bar -->
            <RowDefinition Height="530"/>
            <!-- Main -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>

        <!-- ========================= -->
        <!-- CUSTOM TITLE BAR -->
        <!-- ========================= -->
        <Border Grid.Row="0"
            Grid.ColumnSpan="3"
            Background="#FF45443F">

            <TextBlock Text="Resize Map"
                       Foreground="#E5E5E5"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Realm Map Size Presets" Margin="10,10,10,0" Width="240" Height="480" HorizontalAlignment="Left">
                    <GroupBox.Resources>
                        <Style TargetType="RadioButton">
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <BulletDecorator Background="Transparent">
                                            <BulletDecorator.Bullet>
                                                <Grid Width="13" Height="13">
                                                    <!-- Outer circle -->
                                                    <Ellipse Stroke="#888" StrokeThickness="1" Fill="Transparent"/>

                                                    <!-- Inner dot -->
                                                    <Ellipse x:Name="Dot"
                                                             Width="6.5" Height="6.5"
                                                             Fill="#FF45443F"
                                                             Visibility="Collapsed"/>
                                                </Grid>
                                            </BulletDecorator.Bullet>

                                            <ContentPresenter VerticalAlignment="Center"
                                                    Margin="6,0,0,0"/>
                                        </BulletDecorator>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupBox.Resources>

                    <ScrollViewer 
                            VerticalScrollBarVisibility="Auto"
                            MaxHeight="480">


                        <ItemsControl x:Name="PresetList">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Display}"
                                             Tag="{Binding}"
                                             Margin="0,4"
                                             GroupName="MapSizePresets"
                                             IsChecked="{Binding IsSelected}"
                                             Checked="OnPresetSelected"
                                             LayoutTransform="{StaticResource RadioScaleTransform}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>
                </GroupBox>

                <StackPanel Grid.Column="1" Width="240" HorizontalAlignment="Left" Margin="10,10,0,0" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    </Grid>

                    <GroupBox Header="Resized Realm Map Size"
                            Padding="10"
                            Margin="0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Width -->
                            <TextBlock Text="Width"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,6"/>
                            <Grid Grid.Column="1">
                                <controls:NumericUpDown x:Name="WidthBox"
                                     Value="{Binding Width}"
                                     Minimum="500"
                                     Maximum="10000"
                                     Margin="0,0,6,6"
                                     Width="100"/>
                            </Grid>
                            <!-- Lock -->
                            <Button Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,0,6"
                                    ToolTip="Lock aspect ratio"
                                    Background="#FFDFDBD2"
                                    BorderBrush="#FFDFDBD2"
                                    Click="OnToggleAspectLock">

                                <materialDesign:PackIcon Kind="Lock"
                                     Width="16"
                                     Height="16"
                                     Opacity="0.7"/>
                            </Button>

                            <!-- Height -->
                            <TextBlock Text="Height"
                                   Grid.Row="1"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,6"/>

                            <Grid Grid.Row="1" Grid.Column="1">
                                <controls:NumericUpDown x:Name="HeightBox"                                      
                                     Grid.Column="1"
                                     Value="{Binding Height}"
                                     Minimum="500"
                                     Maximum="10000"
                                     Margin="0,0,6,6"
                                     Width="100"/>
                            </Grid>
                            <!-- Swap -->
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Background="#FFDFDBD2"
                                    BorderBrush="#FFDFDBD2"                                        
                                    ToolTip="Swap width/height"
                                    Click="OnSwapDimensions">

                                <materialDesign:PackIcon Kind="SwapVertical"
                                     Width="18"
                                     Height="18"
                                     Opacity="0.7"/>
                            </Button>

                            <!-- Aspect Ratio -->
                            <TextBlock Grid.Row="2"
                                   Text="Aspect Ratio"
                                   Margin="0,6,8,0"
                                   VerticalAlignment="Center"/>

                            <TextBlock x:Name="AspectRatioText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,6,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#666"
                                   Text="{Binding AspectRatio, StringFormat=F2}"/>

                        </Grid>

                    </GroupBox>

                    <GroupBox Header="Anchor and Scale"
                          Padding="10,10,10,10"
                          Margin="0,10,0,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Resize Map From"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,3"/>

                            <TextBlock Grid.Row="1" Text="{Binding ResizeAnchorPoint}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,3"/>

                            <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Grid.Row="0"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,0,6"
                                        ToolTip="Top Left"
                                        Background="#FFDFDBD2"
                                        BorderBrush="DarkGray"
                                        Tag="TopLeft"
                                        Click="SetResizeAnchor">

                                    <materialDesign:PackIcon Kind="ArrowTopLeft"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <Button Grid.Column="1" Grid.Row="0"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,0,6"
                                        ToolTip="Top Center"
                                        Background="#FFDFDBD2"
                                        BorderBrush="DarkGray"
                                        Tag="TopCenter"
                                        Click="SetResizeAnchor">

                                    <materialDesign:PackIcon Kind="ArrowUp"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <Button Grid.Column="2" Grid.Row="0"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,0,6"
                                        ToolTip="Top Right"
                                        Background="#FFDFDBD2"
                                        BorderBrush="DarkGray"
                                        Tag="TopRight"
                                        Click="SetResizeAnchor">

                                    <materialDesign:PackIcon Kind="ArrowTopRight"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <Button Grid.Column="0" Grid.Row="1"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,0,6"
                                        ToolTip="Center Left"
                                        Background="#FFDFDBD2"
                                        BorderBrush="DarkGray"
                                        Tag="CenterLeft"
                                        Click="SetResizeAnchor">

                                    <materialDesign:PackIcon Kind="ArrowLeft"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <Button Grid.Column="1" Grid.Row="1"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,0,6"
                                        ToolTip="Center"
                                        Background="#FFDFDBD2"
                                        BorderBrush="DarkGray"
                                        Tag="Center"
                                        Click="SetResizeAnchor">

                                    <materialDesign:PackIcon Kind="SquareOutline"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <Button Grid.Column="2" Grid.Row="1"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,0,6"
                                        ToolTip="Center Right"
                                        Background="#FFDFDBD2"
                                        BorderBrush="DarkGray"
                                        Tag="CenterRight"
                                        Click="SetResizeAnchor">

                                    <materialDesign:PackIcon Kind="ArrowRight"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <Button Grid.Column="0" Grid.Row="2"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,0,6"
                                        ToolTip="Bottom Left"
                                        Background="#FFDFDBD2"
                                        BorderBrush="DarkGray"
                                        Tag="BottomLeft"
                                        Click="SetResizeAnchor">

                                    <materialDesign:PackIcon Kind="ArrowBottomLeft"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <Button Grid.Column="1" Grid.Row="2"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,0,6"
                                        ToolTip="Bottom Center"
                                        Background="#FFDFDBD2"
                                        BorderBrush="DarkGray"
                                        Tag="BottomCenter"
                                        Click="SetResizeAnchor">

                                    <materialDesign:PackIcon Kind="ArrowDown"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <Button Grid.Column="2" Grid.Row="2"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,0,6"
                                        ToolTip="Bottom Right"
                                        Background="#FFDFDBD2"
                                        BorderBrush="DarkGray"
                                        Tag="BottomRight"
                                        Click="SetResizeAnchor">

                                    <materialDesign:PackIcon Kind="ArrowBottomRight"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                            </Grid>

                            <Grid Grid.Row="3" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox x:Name="ScaleToggle"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        IsChecked="{Binding ScaleMapEnabled, Mode=TwoWay}"
                                        Style="{StaticResource ToggleSwitchStyle}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,0,1"/>

                                <TextBlock Grid.Column="1" Text="Scale Map to New Size"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,3"/>
                            </Grid>
                        </Grid>



                    </GroupBox>

                    <StackPanel Grid.Row="2" Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,20,0,0">

                        <Button Content="Resize"
                            Command="{Binding ResizeMapCommand}"
                            Style="{StaticResource FlatToolButton}"
                            Margin="0,0,20,0"
                            Width="60"
                            Height="60"/>

                        <Button Content="Cancel"
                            Command="{Binding CancelResizeCommand}"
                            Style="{StaticResource FlatToolButton}"
                            Width="60"
                            Height="60"/>
                    </StackPanel>
                </StackPanel>


            </Grid>
        </StackPanel>

    </Grid>
</ui:ModalDialog>
