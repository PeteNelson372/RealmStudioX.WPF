<ui:ModalDialog x:Class="RealmStudioX.WPF.Views.Dialogs.RealmProperties"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:RealmStudioX.WPF.Views"
        xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
        xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
        xmlns:vm="clr-namespace:RealmStudioX.WPF.ViewModels.Dialogs"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="Realm Properties"
        Width="760"
        Height="700"
        MinWidth="760"
        MaxWidth="760"
        MinHeight="700"
        MaxHeight="700"
        Background="#FF45443F"
        WindowStyle="None"
        ResizeMode="NoResize">

    <!-- WindowChrome -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <ui:ModalDialog.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </ui:ModalDialog.Resources>

    <Grid Margin="10" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- Custom Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Main -->
            <RowDefinition Height="80"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                       Text="Realm Project Properties"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Background="#FF45443F"
                       Foreground="#E5E5E5"
                       VerticalAlignment="Top"
                       Height="30"
                       Padding="20,0,0,0"
                       Margin="0,0,0,0"/>
        
        <Border Grid.Row="1" Grid.Column="0" Padding="0" BorderBrush="#CCC" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                     Padding="4"
                     Margin="10,10,0,0"
                     Text="Realm Id"/>

                    <TextBlock Grid.Column="1"
                     Padding="4"
                     Margin="10,10,20,0"
                     Text="{Binding ProjectViewModel.Project.Metadata.ProjectId}"/>
                </Grid>
                <!-- Realm Name -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                     Padding="4"
                     Margin="10,10,0,0"
                     Text="Realm Name"/>

                    <TextBox Grid.Column="1"
                     Padding="4"
                     Margin="10,10,20,0"
                     IsEnabled="{Binding RealmNameLocked,
                        Converter={StaticResource InverseBooleanConverter}}"
                     Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="1"
                       Text="Enter Realm Name..."
                       Foreground="Gray"
                       Margin="18,10,20,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontStyle="Italic">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProjectName}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding ProjectName}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                    <Button
                        x:Name="GenerateNameButton"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Margin="0,10,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Generate Name"
                        Style="{StaticResource FlatToolButton}"
                        Command="{Binding GenerateRealmNameCommand}">

                        <materialDesign:PackIcon Kind="RenameOutline"
                                     Width="17"
                                     Height="17"
                                     HorizontalAlignment="Center"
                                     Opacity="0.7">
                        </materialDesign:PackIcon>
                    </Button>

                    <Button Grid.Column="3"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        Margin="0,10,14,0"
                        ToolTip="Lock Realm Name"
                        Style="{StaticResource FlatToolButton}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"                                
                        Command="{Binding LockRealmNameCommand}">

                        <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Opacity="0.7">

                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">

                                    <!-- Default = unlocked -->
                                    <Setter Property="Kind" Value="LockOpenOutline"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RealmNameLocked}" Value="True">
                                            <Setter Property="Kind" Value="Lock"/>
                                        </DataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </materialDesign:PackIcon.Style>

                        </materialDesign:PackIcon>
                    </Button>
                </Grid>


                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                     Padding="4"
                     Margin="10,10,0,0"
                     Text="Description"/>

                    <Button x:Name="GenerateRealmDescriptionButton"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"                        
                        Margin="0,36,0,0"
                        Style="{StaticResource FlatToolButton}"
                        Command="{Binding GetRealmDescriptionCommand}"
                        ToolTip="Generate a description for the Realm using RealmStudioX AI integration.">
                        <svgc:SvgViewbox Source="/Assets/svg/OAI_OpenAI-Blossom_Black.svg" Width="22" Height="22" />
                    </Button>

                    <Button
                         x:Name="SetRealmCharacteristicsButton"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"                        
                        Margin="0,76,0,0"
                        Style="{StaticResource FlatToolButton}"
                        Command="{Binding SetRealmCharacteristicsCommand}"
                        ToolTip="Set the type and characteristics of the realm.">
                        <materialDesign:PackIcon Kind="MapLegend"
                                     Foreground="SaddleBrown"
                                     HorizontalAlignment="Center"
                                     Width="24"
                                     Height="24"
                                     Opacity="0.7"/>
                    </Button>

                    <Button
                        x:Name="CreateRealmArticleButton"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"                        
                        Margin="0,116,0,0"
                        Style="{StaticResource FlatToolButton}"
                        ToolTip="Create and upload an article for the realm to World Anvil.">
                        <materialDesign:PackIcon Kind="FileUpload"
                                     Foreground="#FF8C0A0A"
                                     HorizontalAlignment="Center"
                                     Width="24"
                                     Height="24"
                                     Opacity="0.7"/>
                    </Button>

                    <TextBox Grid.Column="1"
                     Padding="4"
                     Height="200"
                     Margin="10,10,20,0"
                     TextWrapping="Wrap"
                     Text="{Binding Project.Metadata.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                     Padding="4"
                     Margin="10,10,0,0"
                     Text="Realm Type"/>

                    <TextBlock Grid.Column="1"
                     Padding="4"
                     Margin="10,10,20,0"
                     Text="{Binding Project.Metadata.RealmType}"/>

                    <TextBlock Grid.Column="2"
                     Padding="4"
                     Margin="10,10,0,0"
                     Text="Created"/>

                    <TextBlock Grid.Column="3"
                     Padding="4"
                     Margin="10,10,20,0"
                     Text="{Binding Project.Metadata.Created}"/>

                    <TextBlock Grid.Column="4"
                     Padding="4"
                     Margin="10,10,0,0"
                     Text="Modified"/>

                    <TextBlock Grid.Column="5"
                     Padding="4"
                     Margin="10,10,20,0"
                     Text="{Binding Project.Metadata.Modified}"/>
                </Grid>

                <GroupBox Margin="5,5,5,0" FontSize="12" FontWeight="Regular" Padding="0" Height="245">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run Text="Maps: "/>
                            <Run Text="{Binding MapTiles.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </GroupBox.Header>
                    
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="MapList"
                             ItemsSource="{Binding MapTiles}"
                             SelectedItem="{Binding SelectedMapTile}"
                             Height="200"
                             Width="160"
                             Margin="3,3,3,3"
                             HorizontalAlignment="Left"
                             BorderThickness="0"
                             Background="Transparent">


                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">

                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>

                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">

                                                    <Border x:Name="Border"
                                                    Background="#FFF2EDE4"
                                                    BorderBrush="#CCC"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Margin="0,2,0,0"
                                                    Padding="0">

                                                        <ContentPresenter VerticalAlignment="Top" HorizontalAlignment="Center"/>

                                                    </Border>

                                                    <ControlTemplate.Triggers>

                                                        <!-- Selected -->
                                                        <Trigger Property="IsSelected" Value="True">

                                                            <Setter TargetName="Border"
                                                            Property="Background"
                                                            Value="#99b0a4"/>

                                                            <Setter Property="Foreground" Value="White"/>

                                                        </Trigger>

                                                        <!-- Hover -->
                                                        <Trigger Property="IsMouseOver" Value="True">

                                                            <Setter TargetName="Border"
                                                        Property="Background"
                                                        Value="#DDD"/>

                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>

                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                               Height="45"
                                               Stretch="UniformToFill"                                    
                                               Source="{Binding PreviewImage}"/>

                                            <Border x:Name="TileOverlay"
                                                Grid.Column="0"
                                                Background="#80D3D3D3"
                                                BorderBrush="#80D3D3D3"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Width="80"
                                                Height="40"
                                                Padding="0">

                                                <StackPanel 
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding MapName}"
                                                    FontWeight="Bold"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Text="{Binding RealmType}"
                                                    FontWeight="Regular"
                                                    FontSize="10"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"                                                           
                                                    TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                        Padding="4"
                                        Margin="10,0,0,0"
                                        Text="Map Id"/>

                                     <TextBlock Grid.Column="1"
                                         Padding="4"
                                         Margin="10,0,20,0"
                                         Text="{Binding SelectedMapTile.MapProjectEntry.MapId}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                        Padding="4"
                                        Margin="10,0,0,0"
                                        Text="Map Name"/>

                                    <TextBox Grid.Column="1"
                                     Padding="4"
                                     Margin="10,0,20,0"
                                     IsEnabled="{Binding MapNameLocked,
                                        Converter={StaticResource InverseBooleanConverter}}"
                                     Text="{Binding SelectedMapTile.MapName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Column="1"
                                       Text="Enter Map Name..."
                                       Foreground="Gray"
                                       Margin="18,0,20,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" FontStyle="Italic">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedMapTile.MapName}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding SelectedMapTile.MapName}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                    <Button
                                        x:Name="GenerateMapNameButton"
                                        Grid.Column="2"
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Generate Name"
                                        Style="{StaticResource FlatToolButton}"
                                        Command="{Binding GenerateMapNameCommand}">

                                        <materialDesign:PackIcon Kind="RenameOutline"
                                             Width="17"
                                             Height="17"
                                             HorizontalAlignment="Center"
                                             Opacity="0.7">
                                        </materialDesign:PackIcon>
                                    </Button>

                                    <Button Grid.Column="3"
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,14,0"
                                        ToolTip="Lock Realm Name"
                                        Style="{StaticResource FlatToolButton}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"                                
                                        Command="{Binding LockMapNameCommand}">

                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Opacity="0.7">

                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">

                                                    <!-- Default = unlocked -->
                                                    <Setter Property="Kind" Value="LockOpenOutline"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MapNameLocked}" Value="True">
                                                            <Setter Property="Kind" Value="Lock"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>

                                                </Style>
                                            </materialDesign:PackIcon.Style>

                                        </materialDesign:PackIcon>
                                    </Button>

                                </Grid>
                                
                                
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0"
                                        Padding="4"
                                        Margin="10,0,0,0"
                                        Text="Realm Type"/>

                                    <TextBlock Grid.Column="1"
                                         Padding="4"
                                         Margin="10,0,20,0"
                                         Text="{Binding SelectedMapTile.MapProjectEntry.Map.RealmType}"/>
                                    <TextBlock Grid.Column="2"
                                        Padding="4"
                                        Margin="10,0,0,0"
                                        Text="Dimensions"/>

                                    <TextBlock Grid.Column="3"
                                         Padding="4"
                                         Margin="10,0,20,0"
                                         Text="{Binding SelectedMapTile.Dimensions}"/>

                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                         Padding="4"
                                         Margin="10,0,0,0"
                                         Text="Description"/>

                                    <Button x:Name="GenerateMapDescriptionButton"
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"                        
                                        Margin="0,30,0,0"
                                        Style="{StaticResource FlatToolButton}"
                                        Command="{Binding GetSelectedMapDescriptionCommand}"
                                        ToolTip="Generate a description for the selected map using RealmStudioX AI integration.">
                                        <svgc:SvgViewbox Source="/Assets/svg/OAI_OpenAI-Blossom_Black.svg" Width="22" Height="22" />
                                    </Button>

                                    <Button
                                        x:Name="SetMapCharacteristicsButton"
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"                        
                                        Margin="0,70,0,0"
                                        Style="{StaticResource FlatToolButton}"
                                        Command="{Binding SetSelectedMapCharacteristicsCommand}"
                                        ToolTip="Set the type and characteristics of the map.">
                                        <materialDesign:PackIcon Kind="MapLegend"
                                             Foreground="SaddleBrown"
                                             HorizontalAlignment="Center"
                                             Width="24"
                                             Height="24"
                                             Opacity="0.7"/>
                                    </Button>

                                    <Button
                                        x:Name="CreateMapArticleButton"
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"                        
                                        Margin="0,110,0,0"
                                        Style="{StaticResource FlatToolButton}"
                                        ToolTip="Create and upload an article for the map to World Anvil.">
                                        <materialDesign:PackIcon Kind="FileUpload"
                                             Foreground="#FF8C0A0A"
                                             HorizontalAlignment="Center"
                                             Width="24"
                                             Height="24"
                                             Opacity="0.7"/>
                                    </Button>

                                    <TextBox Grid.Column="1"
                                     Padding="4"
                                     VerticalAlignment="Top"
                                     Height="130"
                                     Margin="10,10,20,0"
                                     TextWrapping="Wrap"
                                     Text="{Binding SelectedMapTile.MapDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>



            </StackPanel>

        </Border>
        <StackPanel Grid.Row="2" Grid.Column="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,10">

            <Button x:Name="RealmPropertiesOkButton"
                Content="OK"
                    Command="{Binding CloseRealmPropertiesCommand}"
                    Style="{StaticResource FlatToolButton}"
                    Width="60"
                    Height="60"/>
        </StackPanel>

    </Grid>
</ui:ModalDialog>
