<UserControl x:Class="RealmStudioX.WPF.Views.Controls.HeightMapDXMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        
        <Menu Grid.Row="0" Background="#FFDFDBD2"
            Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
            Height="32">

            <MenuItem Header="_File" Margin="10,6,0,0">
                <MenuItem Header="_Open" Command="{Binding OpenModelCommand}"/>
                <MenuItem Header="_Save" Command="{Binding SaveModelCommand}"/>
           
                <Separator/>

                <MenuItem Header="E_xit" Click="OnExit"/>

            </MenuItem>

            <MenuItem Header="_View" Margin="0,6,0,0">
                <MenuItem Header="Fit _Model" Command="{Binding FitModelCommand}"/>
                <MenuItem Header="_Reset Camera" Command="{Binding ResetCameraCommand}"/>

                <Separator/>

                <MenuItem Header="_Front" Command="{Binding ViewFrontCommand}"/>
                <MenuItem Header="_Back" Command="{Binding ViewBackCommand}"/>
                <MenuItem Header="_Left" Command="{Binding ViewLeftCommand}"/>
                <MenuItem Header="_Right" Command="{Binding ViewRightCommand}"/>
                <MenuItem Header="_Top" Command="{Binding ViewTopCommand}"/>
                <MenuItem Header="Botto_m" Command="{Binding ViewBottomCommand}"/>

                <Separator/>

                <MenuItem Header="View_Cube" Command="{Binding ShowViewCubeCommand}" IsCheckable="True" IsChecked="{Binding ShowViewCube, Mode=OneWay}"/>
                <MenuItem Header="_Coordinate System" Command="{Binding ShowCoordinateSystemCommand}" IsCheckable="True" IsChecked="{Binding ShowCoordinateSystem, Mode=OneWay}"/>
                <MenuItem Header="_Grid" Command="{Binding ShowGridCommand}" IsCheckable="True" IsChecked="{Binding ShowGrid, Mode=OneWay}"/>
            </MenuItem>

            <MenuItem Header="_Camera" Margin="0,6,0,0">
                <MenuItem Header="_Reset" Command="{Binding ResetCameraCommand}"/>
                <MenuItem Header="_Up Axis">
                    <MenuItem Header="_X" Command="{Binding SetXUpCommand}"/>
                    <MenuItem Header="_Y" Command="{Binding SetYUpCommand}"/>
                    <MenuItem Header="_Z" Command="{Binding SetZUpCommand}"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Preferences" Margin="0,6,0,0" Command="{Binding OpenPreferencesCommand}"/>

            <MenuItem Header="Help" Margin="0,6,0,0" Command="{Binding Open3DHelpContentsCommand}"/>


        </Menu>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch" Background="#FFCAC7BF">
        
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0" Background="#FFCAC7BF">
                
                <TextBlock Text="Lighting Intensity"
                            Foreground="#FF45443F"
                            FontWeight="DemiBold"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0"/>

                <TextBlock Text="Ambient"
                            Foreground="#FF45443F"
                            VerticalAlignment="Center"
                            Margin="0,0,3,0"/>

                <controls:NumericUpDown x:Name="AmbientLightIntensityBox"
                                         HorizontalAlignment="Center"
                                         Value="{Binding AmbientLightIntensity}"
                                         Minimum="0.00"
                                         Maximum="1.00"
                                         Increment="0.05"
                                         DecimalPlaces="2"
                                         Margin="0,0,6,0"
                                         Width="60"/>

                <TextBlock Text="Key"
                            Foreground="#FF45443F"
                            VerticalAlignment="Center"
                            Margin="20,0,3,0"/>
                <controls:NumericUpDown x:Name="KeyLightIntensityBox"
                                         HorizontalAlignment="Center"
                                         Value="{Binding KeyLightIntensity}"
                                         Minimum="0.00"
                                         Maximum="1.00"
                                         Increment="0.05"
                                         DecimalPlaces="2"
                                         Margin="0,0,6,0"
                                         Width="60"/>

                <TextBlock Text="Fill"
                            Foreground="#FF45443F"
                            VerticalAlignment="Center"
                            Margin="20,0,3,0"/>
                <controls:NumericUpDown x:Name="FillLightIntensityBox"
                                         HorizontalAlignment="Center"
                                         Value="{Binding FillLightIntensity}"
                                         Minimum="0.00"
                                         Maximum="1.00"
                                         Increment="0.05"
                                         DecimalPlaces="2"
                                         Margin="0,0,6,0"
                                         Width="60"/>

            </StackPanel>

            <Button Style="{StaticResource IconBarButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,20,0"
                Command="{Binding Snapshot3DSceneCommand}"
                ToolTip="Snapshot 3D Scene">
                <materialDesign:PackIcon Kind="Camera"
                             Width="22"
                             Height="22"
                             Foreground="Black"/>
            </Button>

        </Grid>

    </Grid>
</UserControl>
