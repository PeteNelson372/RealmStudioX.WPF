<UserControl x:Class="RealmStudioX.WPF.Views.Controls.LandformControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"             
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="72">

    <StackPanel
            Grid.Row="1"
            Orientation="Vertical"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Background="#FFDFDBD2"
            Width="72"
            Height="Auto"
            Margin="0,3,3,0" Grid.ColumnSpan="2" Grid.RowSpan="2">

        <Button
                x:Name="LandformSelectButton"
                Width="50"
                Height="50"
                Margin="0,10,0,0"
                ToolTip="Select Map Object"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding SelectCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Select"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="CursorDefault"
                                     HorizontalAlignment="Center"
                                     Width="20"
                                     Height="20"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <Separator Margin="0,10,0,10" Width="50" Height="1" Background="#FF45443F"/>

        <Button
                x:Name="LandformPaintButton"
                Width="50"
                Height="50"
                Margin="0,0,0,0"
                ToolTip="Paint Landform"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding PaintCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Paint"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="Brush"
                                     Width="24"
                                     Height="24"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>
        <Button
                x:Name="LandformEraseButton"
                Width="50"
                Height="50"
                Margin="0,25,0,0"
                ToolTip="Erase Landform"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding EraseCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Erase"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="Eraser"
                                     Width="22"
                                     Height="22"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <Separator Margin="0,10,0,10" Width="50" Height="1" Background="#FF45443F"/>

        <Button
                x:Name="LandformFillButton"
                Width="50"
                Height="50"
                Margin="0,0,0,0"
                ToolTip="Fill Landform"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding FillLandformCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Fill"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="FormatColorFill"
                                     Width="24"
                                     Height="24"
                                     RenderTransformOrigin="0.5,0.5"
                                     Opacity="0.7">
                </materialDesign:PackIcon>
            </StackPanel>
        </Button>
        <Button
                x:Name="LandformClearButton"
                Width="50"
                Height="50"
                Margin="0,25,0,0"
                ToolTip="Clear Landform"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding ClearLandformCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Clear"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="ImageOffOutline"
                                     Width="24"
                                     Height="24"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <Separator Margin="0,10,0,10" Width="50" Height="1" Background="#FF45443F"/>

        <Button
                x:Name="PaintButton"
                Height="50"
                Margin="0,0,0,0"
                ToolTip="Draw Path"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding PaintBrushCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Brush"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="BrushVariant"
                                     Width="24"
                                     Height="24"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <Button
                x:Name="EraseDrawingButton"
                Height="55"
                Margin="0,25,0,0"
                ToolTip="Erase Drawing"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding ErasePaintCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Erase"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="EraserVariant"
                                     Width="24"
                                     Height="24"
                                     HorizontalAlignment="Center"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <Separator Margin="0,10,0,10" Width="50" Height="1" Background="#FF45443F"/>

        <Grid Width="60" Height="100" Margin="0,0,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main button -->
            <Button
                    x:Name="GenerateLandformsButton"
                    Grid.Row="0"
                    Width="58"
                    Height="58"
                    VerticalAlignment="Top"
                    ToolTip="Generate Landforms"
                    Style="{StaticResource FlatToolButton}"
                    Command="{Binding GenerateLandformsCommand}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Generate"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                    <materialDesign:PackIcon Kind="AutoAwesomeMosaic"
                                     Width="24"
                                     Height="24"
                                     HorizontalAlignment="Center"
                                     Opacity="0.7"/>
                </StackPanel>
            </Button>

        </Grid>

    </StackPanel>
</UserControl>
