<UserControl x:Class="RealmStudioX.WPF.Views.Controls.FontSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:panels="clr-namespace:RealmStudioX.WPF.Views.Panels"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:wf="clr-namespace:SkiaSharp;assembly=SkiaSharp"             
             mc:Ignorable="d"             
             MinWidth="550"
             MinHeight="180"
             Background="#FFDFDBD2">

    <UserControl.Resources>

        <Style x:Key="FlatComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFF8F8F8"/>
            <Setter Property="BorderBrush" Value="#FFC8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF303030"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="ItemContainerStyle">

                <Setter.Value>

                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#FF303030"/>
                        <Setter Property="Padding" Value="4,2"/>

                        <Setter Property="Template">

                            <Setter.Value>

                                <ControlTemplate TargetType="ComboBoxItem">

                                    <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">

                                        <ContentPresenter/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <!-- REMOVE HOVER HIGHLIGHT -->
                                        <Trigger Property="IsMouseOver"
                                            Value="True">

                                            <Setter TargetName="Border"
                                                Property="Background"
                                                Value="#FFE8E8E8"/>

                                        </Trigger>

                                        <!-- Selected Item -->
                                        <Trigger Property="IsSelected"
                                            Value="True">

                                            <Setter TargetName="Border"
                                                Property="Background"
                                                Value="#FFE8E8E8"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Setter.Value>

                        </Setter>

                    </Style>

                </Setter.Value>

            </Setter>
            
            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"/>

                            <Grid Margin="4,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <!-- Selected Item -->
                                <ContentPresenter Grid.Column="0"
                                      Margin="4,0,0,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Content="{Binding SelectedItem,
                                                        RelativeSource={RelativeSource TemplatedParent}}"/>

                                <!-- Arrow -->
                                <Path Grid.Column="1"
                                  Width="10"
                                  Height="6"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Fill="#FFDFDBD2"
                                  Data="M 0 0 L 10 0 L 5 6 Z"/>

                            </Grid>

                            <!-- Click Area -->
                            <ToggleButton Background="Transparent"
                                  BorderThickness="0"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  IsChecked="{Binding IsDropDownOpen,
                                  RelativeSource={RelativeSource TemplatedParent},
                                  Mode=TwoWay}">

                                <ToggleButton.Style>

                                    <Style TargetType="ToggleButton">

                                        <Setter Property="Template">

                                            <Setter.Value>

                                                <ControlTemplate TargetType="ToggleButton">

                                                    <Border Background="Transparent">

                                                        <ContentPresenter/>

                                                    </Border>

                                                </ControlTemplate>

                                            </Setter.Value>

                                        </Setter>

                                    </Style>

                                </ToggleButton.Style>

                            </ToggleButton>

                            <!-- Dropdown -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">

                                <Border Background="White"
                                    BorderBrush="#FFC8C8C8"
                                    BorderThickness="1">

                                    <ScrollViewer MaxHeight="600"
                                        VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <!-- Hover -->
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="#FFDFDBD2"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="#FFDFDBD2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>
    
    <Border BorderBrush="#FFDFDBD2"
            BorderThickness="1"
            Padding="10"
            Background="#FFDFDBD2">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- TOP ROW -->
            <!-- ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Font Family -->
                <ComboBox Grid.Column="0"
                          Height="30"
                          Margin="0,0,8,0"
                          FontSize="16"
                          Style="{StaticResource FlatComboBox}"
                          ItemsSource="{Binding FontItems}"
                          SelectedValuePath="SelectionValue"
                          SelectedValue="{Binding SelectedFontFamily}"
                          VerticalContentAlignment="Center">

                    <ComboBox.ItemContainerStyle>

                        <Style TargetType="ComboBoxItem">

                            <Setter Property="IsEnabled"
                                Value="{Binding IsSelectable}"/>

                        </Style>

                    </ComboBox.ItemContainerStyle>
                    
                    <ComboBox.ItemTemplate>
                        <DataTemplate>

                            <Grid>

                                <!-- Font Item -->
                                <TextBlock x:Name="FontText"
                                   Text="{Binding Text}"
                                   FontFamily="{Binding SelectionValue}"
                                   Margin="4,2"/>

                                <!-- Header -->
                                <TextBlock x:Name="HeaderText"
                                   Text="{Binding Text}"
                                   FontWeight="Bold"
                                   Foreground="#FF707070"
                                   Margin="4,6,4,2"
                                   Visibility="Collapsed"/>

                                <!-- Separator -->
                                <Separator x:Name="Separator"
                                   Margin="2,4"
                                   Visibility="Collapsed"/>

                            </Grid>

                            <DataTemplate.Triggers>

                                <!-- Header -->
                                <DataTrigger Binding="{Binding ItemType}"
                                    Value="Header">

                                    <Setter TargetName="FontText"
                                    Property="Visibility"
                                    Value="Collapsed"/>

                                    <Setter TargetName="HeaderText"
                                        Property="Visibility"
                                        Value="Visible"/>

                                </DataTrigger>

                                <!-- Separator -->
                                <DataTrigger Binding="{Binding ItemType}"
                                    Value="Separator">

                                    <Setter TargetName="FontText"
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                    <Setter TargetName="Separator"
                                        Property="Visibility"
                                        Value="Visible"/>

                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Font Size -->
                <ComboBox Grid.Column="1"
                          Height="30"
                          Margin="0,0,12,0"
                          FontSize="14"
                          Style="{StaticResource FlatComboBox}"
                          ItemsSource="{Binding FontSizes}"
                          SelectedItem="{Binding SelectedFontSize}"
                          VerticalContentAlignment="Center"/>

                <!-- Style Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Increase Size -->
                    <Button Width="28"
                                  Height="28"
                                  Margin="0,0,4,0"
                                  Style="{StaticResource FlatToolButton}"
                                  Command="{Binding IncreaseFontSizeCommand}"
                                  ToolTip="Increase Font Size">

                        <TextBlock Text="A"
                                   FontWeight="Normal"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <!-- Decrease Size -->
                    <Button Width="28"
                                  Height="28"
                                  Margin="0,0,4,0"
                                  Style="{StaticResource FlatToolButton}"
                                  Command="{Binding DecreaseFontSizeCommand}"
                                  ToolTip="Decrease Font Size">

                        <TextBlock Text="A"
                                   FontWeight="Normal"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <!-- Bold -->
                    <ToggleButton Width="28"
                                  Height="28"
                                  Margin="10,0,4,0"
                                  Style="{StaticResource FlatToolToggleButton}"
                                  IsChecked="{Binding IsBold}"
                                  ToolTip="Bold">

                        <TextBlock Text="B"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Italic -->
                    <ToggleButton Width="28"
                                  Height="28"
                                  Margin="0,0,4,0"
                                  Style="{StaticResource FlatToolToggleButton}"
                                  IsChecked="{Binding IsItalic}"
                                  ToolTip="Italic">

                        <TextBlock Text="I"
                                   FontStyle="Italic"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Underline -->
                    <ToggleButton Width="28"
                                  Height="28"
                                  Margin="0,0,4,0"
                                  Style="{StaticResource FlatToolToggleButton}"
                                  IsChecked="{Binding IsUnderline}"
                                  ToolTip="Underline">

                        <TextBlock Text="U"
                                   TextDecorations="Underline"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Superscript -->
                    <ToggleButton Width="28"
                                  Height="28"
                                  Margin="0,0,4,0"
                                  Style="{StaticResource FlatToolToggleButton}"
                                  IsChecked="{Binding IsSuperscript}"
                                  ToolTip="Superscript">

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                            <Run Text="X" FontSize="16"/>
                            <InlineUIContainer BaselineAlignment="Top">

                                <TextBlock Text="1"
                                           FontSize="9"
                                           Margin="-3,-2,0,0"/>

                            </InlineUIContainer>

                        </TextBlock>
                    </ToggleButton>

                    <!-- Subscript -->
                    <ToggleButton Width="28"
                                  Height="28"
                                  Style="{StaticResource FlatToolToggleButton}"
                                  IsChecked="{Binding IsSubscript}"
                                  ToolTip="Subscript">

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                            <Run Text="X" FontSize="16"/>
                            <InlineUIContainer BaselineAlignment="Bottom">

                                <TextBlock Text="1"
                                           FontSize="9"
                                           Margin="-3,-2,0,0"/>

                            </InlineUIContainer>

                        </TextBlock>
                    </ToggleButton>

                </StackPanel>

            </Grid>

            <!-- ================================================= -->
            <!-- PREVIEW -->
            <!-- ================================================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <GroupBox
                    Header="Preview"
                    HorizontalAlignment="Left"
                    Margin="0">
                    
                <Border Background="White"
                        BorderBrush="#FFD5D5D5"
                        BorderThickness="1"
                        Width="345"
                        Height="100"
                        Margin="3,3,3,3"
                        Padding="0">

                        <!-- SKGLControl host -->
                        <wfi:WindowsFormsHost x:Name="ExampleTextFormsHost"                                           
                            Visibility="Visible"
                            Background="Gray"/>
                    
                </Border>

            </GroupBox>
                
            <Button
                Width="60"
                Height="60"
                Margin="0,0,0,5"
                Content="Ok"
                Command="{Binding OkayCommand}"
                Style="{StaticResource FlatToolButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"/>
                
            </Grid>
        </Grid>

    </Border>

</UserControl>
