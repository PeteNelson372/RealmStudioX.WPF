<UserControl x:Class="RealmStudioX.WPF.Views.Controls.HeightMapControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib" 
             mc:Ignorable="d" 
             d:DesignHeight="698" d:DesignWidth="72">

    <!-- RIGHT ICON BAR -->
    <StackPanel
            Grid.Row="1"
            Orientation="Vertical"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Background="#FFDFDBD2"
            Width="72"
            Height="Auto"
            Grid.ColumnSpan="2" Grid.RowSpan="2">

        <Button
                x:Name="LandformSelectButton"
                Width="58"
                Height="58"
                Margin="0,10,0,0"
                ToolTip="Select Map Object"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding SelectCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Select"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="CursorDefault"
                                     HorizontalAlignment="Center"
                                     Width="20"
                                     Height="20"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <Separator Margin="0,10,0,10" Width="50" Height="2" Background="#FF45443F"/>

        <Button
                x:Name="IncreaseElevationButton"
                Width="58"
                Height="58"
                Margin="0,10,0,0"
                ToolTip="Increase Elevation"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding IncreaseElevationCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Increase"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="SortDescending"
                                     HorizontalAlignment="Center"
                                     Width="20"
                                     Height="20"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <Button
                x:Name="DecreaseElevationButton"
                Width="58"
                Height="58"
                Margin="0,10,0,0"
                ToolTip="Decrease Elevation"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding DecreaseElevationCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Decrease"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="SortAscending"
                                     HorizontalAlignment="Center"
                                     Width="20"
                                     Height="20"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <TextBlock
                HorizontalAlignment="Center"
                Margin="0,20,0,3">
            <Run Text="Increase /"/>
            <LineBreak/>
            <Run Text="Decrease"/>
            <LineBreak/>
            <Run Text="Amount"/>
        </TextBlock>
        <Grid>
            <controls:NumericUpDown x:Name="HeightChangeBox"
                                     Value="{Binding ElevationChange}"
                                     Minimum="{Binding MinElevationChange}"
                                     Maximum="{Binding MaxElevationChange}"                                     
                                     Margin="4,0,0,10"
                                     Width="60"/>
        </Grid>

        <Button
                x:Name="SmoothBrushButton"
                Width="58"
                Height="58"
                Margin="0,10,0,0"
                ToolTip="Smooth Elevation"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding SmoothElevationCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Smooth"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="SmoothingIronOutline"
                                     HorizontalAlignment="Center"
                                     Width="24"
                                     Height="24"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <TextBlock
                HorizontalAlignment="Center"
                Margin="0,20,0,3">
            <Run Text="Smoothing"/>
            <LineBreak/>
            <Run Text="Strength"/>
        </TextBlock>
        <Grid>
            <controls:NumericUpDown x:Name="SmoothingStrengthBox"
                                     Value="{Binding SmoothingStrength}"                                    
                                     Minimum="{Binding MinSmoothingStrength}"
                                     Maximum="{Binding MaxSmoothingStrength}"                                    
                                     Margin="4,0,0,10"
                                     Width="60" CoarseFactor="1" FineFactor="1"/>
        </Grid>

        <Separator Margin="0,15,0,10" Width="50" Height="2" Background="#FF45443F"/>
        <Button
                x:Name="ThreeDViewButton"
                Width="58"
                Height="58"
                Margin="0,15,0,0"
                ToolTip="Decrease Height"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding Open3DViewCommand}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="3D View"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                <materialDesign:PackIcon Kind="CubeOutline"
                                     HorizontalAlignment="Center"
                                     Width="20"
                                     Height="20"
                                     Opacity="0.7"/>
            </StackPanel>
        </Button>

        <TextBlock
                HorizontalAlignment="Center"
                Margin="0,20,0,3">
            <Run Text="Elevation"/>
            <LineBreak/>
            <Run Text="Scale"/>
        </TextBlock>
        <Grid>
            <controls:NumericUpDown x:Name="ElevationScaleChangeBox"
                                     Value="{Binding ElevationScale}"
                                     Minimum="{Binding MinElevationScale}"
                                     Maximum="{Binding MaxElevationScale}"                                     
                                     Margin="4,0,0,20"
                                     Width="60"/>
        </Grid>

    </StackPanel>


</UserControl>
