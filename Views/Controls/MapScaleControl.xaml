<UserControl x:Class="RealmStudioX.WPF.Views.Controls.MapScaleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"             
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:core="clr-namespace:RealmStudioX.Core;assembly=RealmStudioX.Core"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"             
             mc:Ignorable="d"
             MinWidth="200"
             MinHeight="830"
             Background="#FFDFDBD2"             
             d:DesignHeight="830" d:DesignWidth="200">

    <Border BorderBrush="#FFDFDBD2"
            BorderThickness="1"
            Background="#FFDFDBD2"
            CornerRadius="2">

        <Grid Visibility="Visible" Background="#FFDFDBD2" Margin="3,3,3,3">

            <GroupBox Header="Map Scale"
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Width="187"
            Height="Auto"
            Margin="3,3,0,0" Grid.ColumnSpan="2">

                <StackPanel
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">

                    <StackPanel
                        Orientation="Vertical"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Width="170"
                        Height="Auto"
                        Margin="3,3,3,3">

                        <TextBlock Text="Width"
                            Foreground="#FF45443F"
                            VerticalAlignment="Center"
                            Margin="3,3,3,3"/>

                        <Slider x:Name="ScaleWidthSlider"
                            Style="{StaticResource ModernSlider}"
                            Width="150"
                            Minimum="64"
                            Maximum="2048"
                            SmallChange="1"
                            LargeChange="10"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            Value="{Binding ScaleWidth}"/>
                    </StackPanel>

                    <StackPanel
                        Orientation="Vertical"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Width="170"
                        Height="Auto"
                        Margin="3,3,3,3">

                        <TextBlock Text="Height"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,3,3,3"/>

                        <Slider x:Name="ScaleHeightSlider"
                            Style="{StaticResource ModernSlider}"
                            Width="150"
                            Minimum="4"
                            Maximum="64"
                            SmallChange="1"
                            LargeChange="2"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            Value="{Binding ScaleHeight}"/>
                    </StackPanel>

                    <StackPanel
                        Orientation="Vertical"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Width="170"
                        Height="Auto"
                        Margin="3,3,3,3">

                        <TextBlock Text="Segments"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,3,3,3"/>

                        <Slider x:Name="ScaleSegmentsSlider"
                            Style="{StaticResource ModernSlider}"
                            Width="150"
                            Minimum="1"
                            Maximum="10"
                            SmallChange="1"
                            LargeChange="2"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            Value="{Binding ScaleSegments}"/>
                    </StackPanel>

                    <StackPanel
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Width="170"
                    Height="Auto"
                    Margin="3,3,3,3">

                        <TextBlock Text="Line Width"
                            Foreground="#FF45443F"
                            VerticalAlignment="Center"
                            Margin="3,3,3,3"/>

                        <Slider x:Name="LineWidthSlider"
                            Style="{StaticResource ModernSlider}"
                            Width="150"
                            Minimum="1"
                            Maximum="10"
                            SmallChange="1"
                            LargeChange="2"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            Value="{Binding ScaleLineWidth}"/>
                    </StackPanel>

                    <TextBlock Text="Segment Colors"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,10,3,3"/>
                    <Grid Margin="3,3,3,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button
                            x:Name="ScaleColor1Button"
                            Grid.Column="0"
                            Style="{StaticResource FlatToolButton}"
                            Width="50"
                            Height="50"
                            Margin="3,3,3,3"
                            Background="{Binding SegmentColor1Brush}"
                            ToolTip="Select Segment Color"
                            PreviewMouseLeftButtonUp="SegmentColor1_LeftClick"
                            PreviewMouseRightButtonUp="SegmentColor1_RightClick">

                            <materialDesign:PackIcon Kind="PaletteOutline"
                                    Foreground="Tan"
                                    Width="36"
                                    Height="36"
                                    Opacity="0.7"/>
                        </Button>
                        
                        <Button
                            x:Name="ScaleColor2Button"
                            Grid.Column="1"
                            Style="{StaticResource FlatToolButton}"
                            Width="50"
                            Height="50"
                            Margin="3,3,3,3"
                            Background="{Binding SegmentColor2Brush}"
                            ToolTip="Select Segment Color"
                            PreviewMouseLeftButtonUp="SegmentColor2_LeftClick"
                            PreviewMouseRightButtonUp="SegmentColor2_RightClick">

                            <materialDesign:PackIcon Kind="PaletteOutline"
                                    Foreground="Tan"
                                    Width="36"
                                    Height="36"
                                    Opacity="0.7"/>
                        </Button>
                        
                        <Button
                            x:Name="ScaleColor3Button"
                            Grid.Column="2"
                            Style="{StaticResource FlatToolButton}"
                            Width="50"
                            Height="50"
                            Margin="3,3,3,3"
                            Background="{Binding SegmentColor3Brush}"
                            ToolTip="Select Segment Color"
                            PreviewMouseLeftButtonUp="SegmentColor3_LeftClick"
                            PreviewMouseRightButtonUp="SegmentColor3_RightClick">

                            <materialDesign:PackIcon Kind="PaletteOutline"
                                    Foreground="Tan"
                                    Width="36"
                                    Height="36"
                                    Opacity="0.7"/>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                            Text="Segment Distance"
                            Foreground="#FF45443F"
                            VerticalAlignment="Center"
                            Margin="3,3,3,3"/>
                        <controls:NumericUpDown x:Name="SegmentDistanceBox"
                                     Grid.Column="1"
                                     HorizontalAlignment="Right"
                                     Value="{Binding SegmentDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Minimum="0.1"
                                     Maximum="10000"
                                     Increment="0.1"
                                     DecimalPlaces="1"
                                     Margin="3,0,0,0"
                                     Width="65"/>                        

                    </Grid>

                    <TextBlock Text="Unit Label"
                       Foreground="#FF45443F"
                       Margin="3,10,3,3"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

                    <Grid>
                        <TextBox
                         Padding="4"
                         Margin="3,0,3,0"
                         Text="{Binding UnitLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Enter Unit Label..."
                           Foreground="Gray"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" FontStyle="Italic">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnitLabel}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding UnitLabel}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                    <StackPanel
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Width="130"
                    Height="Auto"
                    Margin="3,3,3,3">

                        <TextBlock Text="Numbers Display"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,10,3,3"/>

                        <RadioButton Content="None" GroupName="NumbersDisplay"
                            Margin="10,3,3,3"
                            IsChecked="{Binding ScaleNumbersDisplayLocation,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:ScaleNumbersDisplayLocation.None}}"/>

                        <RadioButton Content="Ends" GroupName="NumbersDisplay"
                            Margin="10,3,3,3"
                            IsChecked="{Binding ScaleNumbersDisplayLocation,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:ScaleNumbersDisplayLocation.Ends}}"/>

                        <RadioButton Content="Every Other" GroupName="NumbersDisplay"
                            Margin="10,3,3,3"
                            IsChecked="{Binding ScaleNumbersDisplayLocation,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:ScaleNumbersDisplayLocation.EveryOther}}"/>

                        <RadioButton Content="All" GroupName="NumbersDisplay"
                            Margin="10,3,3,3"
                            IsChecked="{Binding ScaleNumbersDisplayLocation,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter={x:Static rendering:ScaleNumbersDisplayLocation.All}}"/>
                    </StackPanel>

                    <TextBlock Text="Font"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,10,3,3"/>
                    <Grid Margin="3,3,3,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="LabelFontButton"
                            Style="{StaticResource FlatToolButton}"
                            Width="60"
                            Height="60"
                            Margin="3,3,3,3"
                            Background="GhostWhite"
                            ToolTip="Select Font"
                            FontFamily="{Binding SelectedFontFamily}"
                            Command="{Binding OpenFontPopupCommand}">

                            <Grid>
                                <TextBlock Text="A"
                                   FontSize="36"
                                   FontFamily="Book Antiqua"
                                   FontWeight="DemiBold"
                                   Foreground="Tan"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,0"/>

                                <TextBlock Text="Select"
                                   FontSize="12"
                                   Foreground="#FF45443F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding SelectedFontFamily}"
                                   FontSize="9.5"
                                   Foreground="#FF45443F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,3,0,3"/>
                            </Grid>
                        </Button>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource FlatToolButton}"
                            Width="60"
                            Height="60"
                            Margin="3,3,3,3"
                            Background="{Binding FontColorBrush}"
                            ToolTip="Select Font Color"
                            PreviewMouseLeftButtonUp="FontColor_LeftClick"
                            PreviewMouseRightButtonUp="FontColor_RightClick">
                            
                            <Grid>
                                <materialDesign:PackIcon Kind="PaletteOutline"
                                    Width="36"
                                    Height="36"
                                    Foreground="Tan"
                                    Opacity="0.7"/>
                            </Grid>

                        </Button>

                    </Grid>

                    <TextBlock Text="Numbers Outline"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,10,3,3"/>

                    <Grid Margin="3,3,3,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Style="{StaticResource FlatToolButton}"
                            Width="50"
                            Height="50"
                            Margin="0,0,0,0"
                            Background="{Binding NumbersOutlineColorBrush}"
                            ToolTip="Select Number Outline Color"
                            PreviewMouseLeftButtonUp="NumbersOutlineColor_LeftClick"
                            PreviewMouseRightButtonUp="NumbersOutlineColor_RightClick">
                            
                            <Grid>
                                <materialDesign:PackIcon Kind="PaletteOutline"
                                    Width="36"
                                    Height="36"
                                    Foreground="Tan"
                                    Opacity="0.7"/>
                            </Grid>

                        </Button>

                        <StackPanel
                        Grid.Column="1"
                        Orientation="Vertical"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Width="100"
                        Height="Auto"
                        Margin="6,3,3,3">

                            <TextBlock Text="Outline Width"
                            Foreground="#FF45443F"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Margin="3,3,3,3"/>

                            <Slider x:Name="OutlineWidthSlider"
                                Style="{StaticResource ModernSlider}"
                                Width="90"
                                Minimum="0"
                                Maximum="32"
                                SmallChange="1"
                                LargeChange="2"
                                AutoToolTipPlacement="TopLeft"
                                AutoToolTipPrecision="0"
                                Value="{Binding NumbersOutlineWidth}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="3,20,3,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="CreateScaleButton"
                            Style="{StaticResource FlatToolButton}"
                            Width="60"
                            Height="60"
                            Margin="3,3,3,3"
                            Background="GhostWhite"
                            ToolTip="Create Map Scale"
                            Command="{Binding CreateScaleCommand}">

                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Create"
                                   FontSize="12"
                                   Foreground="#FF45443F"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,0"/>
                                <materialDesign:PackIcon Kind="Ruler"
                                     Width="28"
                                     Height="28"
                                     HorizontalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5"
                                     Opacity="0.7">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <RotateTransform Angle="45"/>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="RemoveScaleButton"
                            Grid.Column="1"
                            Style="{StaticResource FlatToolButton}"
                            Width="60"
                            Height="60"
                            Margin="3,3,3,3"
                            Background="GhostWhite"
                            ToolTip="Remove Map Scale"
                            Command="{Binding RemoveScaleCommand}">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Remove"
                                   FontSize="12"
                                   Foreground="#FF45443F"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,0"/>
                                <materialDesign:PackIcon Kind="ClearCircleOutline"
                                     Width="28"
                                     Height="28"
                                     HorizontalAlignment="Center"
                                     Opacity="0.7">
                                </materialDesign:PackIcon>
                            </StackPanel>

                        </Button>

                    </Grid>

                </StackPanel>

            </GroupBox>
        </Grid>
    </Border>
</UserControl>
