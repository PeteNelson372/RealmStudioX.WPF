<UserControl x:Class="RealmStudioX.WPF.Views.Panels.RegionsToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"             
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"               
             mc:Ignorable="d"
             d:DesignHeight="922" d:DesignWidth="152">

    <Border Background="#FFDFDBD2"
            Padding="10">

        <StackPanel Orientation="Vertical">
            <!-- Header -->
            <TextBlock Text="Border Style"
                       FontSize="14"
                       Foreground="Black"
                       Margin="10,20,0,8"/>

            <StackPanel
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <!-- solid line is default -->
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.SolidLinePath}"
                                 IsChecked="True"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/SolidPath.png"
                           Width="110"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">
                    </Image>
                </RadioButton>
            </StackPanel>

            <StackPanel
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.DottedLinePath}"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/DottedPath.png"
                           Width="100"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">
                    </Image>
                </RadioButton>
            </StackPanel>


            <StackPanel
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.DashedLinePath}"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/DashPath.png"
                           Width="100"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">
                    </Image>
                </RadioButton>
            </StackPanel>

            <StackPanel
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.DashDotLinePath}"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/DashDotPath.png"
                           Width="100"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">
                    </Image>
                </RadioButton>
            </StackPanel>

            <StackPanel
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.DashDotDotLinePath}"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/DashDotDotPath.png"
                           Width="110"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           Margin="-5,0,0,0">
                    </Image>
                </RadioButton>
            </StackPanel>

            <StackPanel
                    HorizontalAlignment="Left"
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.DoubleSolidBorderPath}"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/DoubleLinePath.png"
                           Width="100"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">
                    </Image>
                </RadioButton>
            </StackPanel>

            <StackPanel
                    HorizontalAlignment="Left"
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.LineAndDashesPath}"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/LineDashPath.png"
                           Width="100"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">
                    </Image>
                </RadioButton>
            </StackPanel>


            <StackPanel
                    HorizontalAlignment="Left"
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.SolidBlackBorderPath}"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/BorderedLinePath.png"
                           Width="100"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">
                    </Image>
                </RadioButton>
            </StackPanel>

            <StackPanel
                    HorizontalAlignment="Left"
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.BorderedGradientPath}"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/ShadedLinePath.png"
                           Width="100"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">
                    </Image>
                </RadioButton>
            </StackPanel>

            <StackPanel
                    HorizontalAlignment="Left"
                    Width="Auto"
                    Height="Auto"
                    Margin="3,3,3,3">
                <RadioButton GroupName="RegionStyleGroup"
                                 VerticalAlignment="Center"
                                 Tag="{x:Static rendering:PathType.BorderedLightSolidPath}"
                                 Checked="RegionStyle_Checked">
                    <Image Source="/Assets/png/SingleBorderLinePath.png"
                           Width="100"
                           Height="22"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">
                    </Image>
                </RadioButton>
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
