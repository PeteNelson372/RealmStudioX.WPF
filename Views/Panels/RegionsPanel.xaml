<UserControl x:Class="RealmStudioX.WPF.Views.Panels.RegionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"             
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:core="clr-namespace:RealmStudioX.Core;assembly=RealmStudioX.Core"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"
             mc:Ignorable="d" 
             d:DesignHeight="916" d:DesignWidth="235">
    <Grid Visibility="Visible" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="72"/>
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="1"
            Orientation="Vertical"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Width="72"
            Height="Auto"
            Margin="0,3,3,0" Grid.ColumnSpan="2" Grid.RowSpan="2">

            <Button
                x:Name="OverlaySelectButton"
                Width="60"
                Height="60"
                Margin="0,10,0,0"
                ToolTip="Select Map Object"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding SelectCommand}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Select"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                    <materialDesign:PackIcon Kind="CursorDefault"
                                     HorizontalAlignment="Center"
                                     Width="20"
                                     Height="20"
                                     Opacity="0.7"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="CreateRegionButton"
                Width="60"
                Height="60"
                Margin="0,35,0,0"
                ToolTip="Create Region"
                Style="{StaticResource FlatToolButton}"
                Command="{Binding CreateRegionCommand}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Create"
                               FontSize="12"
                               Foreground="#FF45443F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,0"/>
                    <materialDesign:PackIcon Kind="FlagPlusOutline"
                                     Width="28"
                                     Height="28"
                                     Opacity="0.7">
                    </materialDesign:PackIcon>
                </StackPanel>
            </Button>

        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Orientation="Horizontal"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Width="74"
            Height="32"
            Margin="3,3,0,0" Grid.RowSpan="2">

            <CheckBox x:Name="RegionEnabledToggle"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="True"
                        Style="{StaticResource ToggleSwitchStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <TextBlock Text="Show"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,3,6,3"/>
        </StackPanel>

        <GroupBox Header="Region"
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Width="154"
            Height="Auto"
            Margin="3,0,0,0" Grid.ColumnSpan="2">

            <StackPanel
                Orientation="Vertical"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Width="Auto"
                Height="Auto"
                Margin="3,3,3,3">

                <Button
                    Style="{StaticResource FlatToolButton}"
                    Width="120"
                    Height="50"
                    Margin="3,3,3,10"
                    Background="{Binding RegionColorBrush}"
                    ToolTip="Select Region Color"
                    PreviewMouseLeftButtonUp="RegionColor_LeftClick"
                    PreviewMouseRightButtonUp="RegionColor_RightClick">

                    <materialDesign:PackIcon Kind="PaletteOutline"
                                    Width="36"
                                    Height="36"
                                    Opacity="0.7"/>
                </Button>

                <StackPanel
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Width="130"
                    Height="Auto"
                    Margin="3,3,3,3">

                    <TextBlock Text="Border Width"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,3,3,3"/>

                    <Slider x:Name="BorderWidthSlider"
                            Style="{StaticResource ModernSlider}"
                            behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            Width="126"
                            Minimum="2"
                            Maximum="20"
                            Value="{Binding RegionBorderWidth}"/>

                </StackPanel>

                <StackPanel
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Width="130"
                    Height="Auto"
                    Margin="3,3,3,3">

                    <TextBlock Text="Smoothing"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,3,3,3"/>

                    <Slider x:Name="SmoothingSlider"
                            Style="{StaticResource ModernSlider}"
                            behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            Width="126"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Smoothing}"/>

                </StackPanel>

                <StackPanel
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Width="130"
                    Height="Auto"
                    Margin="3,3,3,3">

                    <TextBlock Text="Inner Opacity"
                        Foreground="#FF45443F"
                        VerticalAlignment="Center"
                        Margin="3,3,3,3"/>

                    <Slider x:Name="InnerOpacitySlider"
                            Style="{StaticResource ModernSlider}"
                            behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            Width="126"
                            Minimum="0"
                            Maximum="255"
                            Value="{Binding InnerOpacity}"/>

                </StackPanel>

            </StackPanel>
        </GroupBox>
        <RichTextBox Grid.Row="3" Width="154" Margin="3,20,3,3" Background="#FFDFDBD2">
            <FlowDocument>
                <Paragraph>
                    <Run Text="Click on the map to set a point in the region."/>
                </Paragraph>
                <Paragraph>
                    <Run Text="Drag to the next location, then click to set the point."/>
                </Paragraph>
                <Paragraph>
                    <Run Text="Right-click to end drawing the region."/>
                </Paragraph>
                <Paragraph>
                    <Run Text="Shift+click on a landform coastline to begin snapping the region to the coastline of the landform."/>
                </Paragraph>
                <Paragraph>
                    <Run Text="When the cursor is close enough to the coastline to snap to it, a gold-colored circle will be displayed at the snap point."/>
                </Paragraph>
                <Paragraph>
                    <Run Text="To snap the region to the coastline, click on the snap point, then hold down the shift key and trace around the coastline while pressing the left mouse button."/>
                </Paragraph>
                <Paragraph>
                    <Run Text="Release the shift key to stop snapping. Hold down the shift key to begin snapping again. When not snapping, click the left mouse button to set points on the region boundary."/>
                </Paragraph>                
            </FlowDocument>
        </RichTextBox>
    </Grid>
</UserControl>
