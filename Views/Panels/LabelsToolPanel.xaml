<UserControl x:Class="RealmStudioX.WPF.Views.Panels.LabelsToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"             
             mc:Ignorable="d"
             d:DesignHeight="922" d:DesignWidth="152">

    <Border Background="#FFDFDBD2"
            Padding="6">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <!-- Search Box -->
                <RowDefinition Height="*"/>
                <!-- Symbol Grid -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button
                        x:Name="BoxTintButton"
                        Style="{StaticResource FlatToolButton}"
                        Width="120"
                        Height="50"
                        Margin="3,10,3,10"
                        Background="{Binding BoxTintBrush}"
                        ToolTip="Select Label Color"
                        PreviewMouseLeftButtonUp="BoxTint_LeftClick"
                        PreviewMouseRightButtonUp="BoxTint_RightClick">

                    <Grid>
                        <materialDesign:PackIcon
                                Kind="PaletteOutline"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="Tan"
                                Opacity="0.7"/>

                        <TextBlock Text="Select Color"
                                   FontSize="12"
                                   Foreground="#FF45443F"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,0"/>

                    </Grid>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Width="144" Margin="0,0,0,10">

                <ListBox
                    ItemsSource="{Binding BoxItems}"
                    SelectedItem="{Binding SelectedBox}"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <!-- Layout -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- Item Container -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">

                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>

                            <!-- removes default blue highlight -->
                            <Setter Property="Template">
                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border x:Name="Border"
                                            BorderBrush="Gray"
                                            BorderThickness="0.5"
                                            Width="100"
                                            Height="60"
                                            Padding="1"
                                            Background="Transparent">

                                            <ContentPresenter/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsSelected" Value="True">

                                                <Setter TargetName="Border"
                                                    Property="BorderBrush"
                                                    Value="#FF4A90E2"/>

                                                <Setter TargetName="Border"
                                            Property="BorderThickness"
                                            Value="2"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>
                            </Setter>

                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- Item content -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Image Source="{Binding BoxImage}"
                       Stretch="Uniform"/>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>
        </Grid>

    </Border>

</UserControl>
