<UserControl x:Class="RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels.AtmosphereTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"              
             mc:Ignorable="d" 
             d:DesignHeight="542" d:DesignWidth="300">

    <Grid DockPanel.Dock="Top" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="World Atmosphere Properties"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="10,4,0,8" />

        <TabControl x:Name="PropertiesTabs" Grid.Row="1"  ItemContainerStyle="{StaticResource RoundedTabItemStyle}" Background="#FFDFDBD2">

            <TabItem Header="Atmosphere">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Width="Auto"
                            Height="Auto"
                            Margin="0,0,0,0">

                            <CheckBox x:Name="EnableAtmosphereCheckBox"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Command="{Binding ToggleAtmosphere}"
                                  IsChecked="{Binding AtmosphereModel.EnableAtmosphere, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                            <TextBlock Text="Show Atmosphere"
                                Foreground="#FF45443F"
                                VerticalAlignment="Center"
                                Margin="4,0,10,0"/>
                        </StackPanel>

                        <GroupBox Header="Atmosphere" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,10,0,10">
                            <Grid>
                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Atmosphere Color"
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"                                       
                                        Style="{StaticResource FlatToolButton}"
                                        Width="120"
                                        Height="50"
                                        Margin="3,3,3,3"
                                        Background="{Binding AtmosphereModel.AtmosphereColorBrush}"
                                        ToolTip="Select Fill Color"
                                        PreviewMouseLeftButtonUp="AtmosphereColor_LeftClick"
                                        PreviewMouseRightButtonUp="AtmosphereColor_RightClick">

                                        <materialDesign:PackIcon Kind="PaletteOutline"
                                            Width="36"
                                            Height="36"
                                            Foreground="Tan"
                                            Opacity="0.7"/>
                                    </Button>

                                    <TextBlock Text="Altitude"
                                        Grid.Row="1"
                                        Grid.Column="0"                                               
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>

                                    <Slider x:Name="AtmosphereAltitudeSlider"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                        Width="120"
                                        Minimum="0"
                                        Maximum="150"
                                        AutoToolTipPlacement="TopLeft"
                                        ToolTip="{Binding AtmosphereModel.AtmosphereDensity, StringFormat={}{0:F1}}"                                            
                                        Value="{Binding AtmosphereModel.AtmosphereAltitude}"/>

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Text="Density"
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,10,0"/>

                                    <Slider x:Name="AtmosphereDensitySlider"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                        Width="120"
                                        Minimum="0"
                                        Maximum="100"
                                        AutoToolTipPlacement="TopLeft"
                                        ToolTip="{Binding AtmosphereModel.AtmosphereDensity, StringFormat={}{0:F1}}"
                                        Value="{Binding AtmosphereModel.AtmosphereDensity}"/>

                            </Grid>
                        </GroupBox>
                    </StackPanel>

                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Clouds">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Width="Auto"
                            Height="Auto"
                            Margin="0,0,0,0">

                            <CheckBox x:Name="EnableCloudsCheckBox"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AtmosphereModel.EnableClouds, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                            <TextBlock Text="Show Cloud Layer"
                                Foreground="#FF45443F"
                                VerticalAlignment="Center"
                                Margin="4,0,10,0"/>
                        </StackPanel>

                        <GroupBox Header="Clouds" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,0,0,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Cloud Color"
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>
                                <Button
                                        Grid.Row="0"
                                        Grid.Column="1"                                       
                                        Style="{StaticResource FlatToolButton}"
                                        Width="120"
                                        Height="50"
                                        Margin="3,3,3,3"
                                        Background="{Binding AtmosphereModel.CloudColorBrush}"
                                        ToolTip="Select Cloud Color"
                                        PreviewMouseLeftButtonUp="CloudColor_LeftClick"
                                        PreviewMouseRightButtonUp="CloudColor_RightClick">

                                    <materialDesign:PackIcon Kind="PaletteOutline"
                                            Width="36"
                                            Height="36"
                                            Foreground="Tan"
                                            Opacity="0.7"/>
                                </Button>

                                <TextBlock Text="Opacity"
                                        Grid.Row="1"
                                        Grid.Column="0"                                               
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>

                                <Slider x:Name="CloudOpacitySlider"
                                        Grid.Row="1"
                                        Grid.Column="1"                                             
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Minimum="0"
                                        Maximum="1.0"
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="0.01"
                                        Value="{Binding AtmosphereModel.CloudOpacity}"/>
                                
                                <TextBlock
                                       Grid.Row="2"
                                       Grid.Column="0"                                       
                                       Text="Texture"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,0"/>

                                <StackPanel Orientation="Vertical" Grid.Row="2" Grid.Column="1" Margin="0,10,0,10">
                                    <StackPanel Orientation="Vertical">
                                        <RadioButton Content="Default"
                                             Margin="6,2,0,0"
                                             GroupName="CloudTexture"
                                             IsChecked="{Binding AtmosphereModel.UseDefaultCloudTexture, Mode=TwoWay}"/>
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"                                       
                                            Text="(NASA Blue Marble)"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left"
                                            Margin="25,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Custom"
                                                 Margin="6,8,0,0"
                                                 GroupName="CloudTexture"
                                                 IsChecked="{Binding AtmosphereModel.UseCustomCloudTexture, Mode=TwoWay}"/>

                                        <Button                                       
                                            Style="{StaticResource FlatToolButton}"
                                            Width="24"
                                            Height="24"
                                            Margin="2,4,0,0"
                                            Padding="0,0,0,0"
                                            ToolTip="Select Cloud Texture"
                                            Command="{Binding AtmosphereModel.SelectCloudTextureCommand}">

                                            <materialDesign:PackIcon Kind="FileImageAddOutline"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,0,0"
                                                Foreground="#FF45443F"
                                                Opacity="0.7"/>
                                        </Button>
                                    </StackPanel>

                                </StackPanel>

                            </Grid>
                        </GroupBox>
                    </StackPanel>

                </ScrollViewer>
            </TabItem>

            <!-- Animation properties -->
            <TabItem Header="Animation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <GroupBox Header="Clouds" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,10,0,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Rotation Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,0,8,6"/>

                                <controls:NumericUpDown x:Name="CloudRotationRateBox"
                                             Grid.Row="0" Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding AtmosphereModel.CloudRotationRate}"
                                             Minimum="0.1"
                                             Maximum="10.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,0,0,0"
                                             Width="100" />
                            </Grid>
                        </GroupBox>

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
