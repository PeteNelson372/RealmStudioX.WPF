<UserControl x:Class="RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels.PlanetsTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="300">

    <UserControl.Resources>
        <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />

        <DataTemplate x:Key="EnumDescriptionTemplate">
            <TextBlock
            Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
        </DataTemplate>

        <Style x:Key="FixedOrderTabControl" TargetType="{x:Type TabControl}">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                      SnapsToDevicePixels="True">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Headers remain in item order. -->
                            <WrapPanel Grid.Row="0"
                               IsItemsHost="True"
                               Orientation="Horizontal"
                               Margin="2,2,2,0"
                               Panel.ZIndex="1" />

                            <!-- Selected tab content. -->
                            <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">

                                <ContentPresenter
                                    x:Name="PART_SelectedContentHost"
                                    ContentSource="SelectedContent"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid DockPanel.Dock="Top" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="Planet Properties"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="10,4,0,8" />

        <TabControl x:Name="PropertiesTabs" Grid.Row="1" ItemContainerStyle="{StaticResource RoundedTabItemStyle}"  Style="{StaticResource FixedOrderTabControl}" Background="#FFDFDBD2">

            <!-- Texture properties -->
            <TabItem Header="Planet">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <GroupBox Header="Planet Properties" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="10,10,10,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Planet Type"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="10,3,3,3"/>

                                <ComboBox x:Name="PlanetTypeCombo"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Width="120"
                                    Height="26"
                                    Background="#FFDFDBD2"
                                    ItemsSource="{Binding StarViewModel.LocalStarTypes}"
                                    SelectedItem="{Binding StarViewModel.SelectedLocalStarType, Mode=TwoWay}"
                                    ItemTemplate="{StaticResource EnumDescriptionTemplate}" />

                                <TextBlock Text="Size"
                                    Grid.Row="1"
                                    Grid.Column="0"                                               
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>

                                <Slider x:Name="StarSizeSlider"
                                    Grid.Row="1"
                                    Grid.Column="1"                                             
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Minimum="0.01"
                                    Maximum="1.0"                                        
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="0.01"
                                    Value="{Binding StarViewModel.LocalStarSize}"/>


                                <TextBlock Text="Distance"
                                    Grid.Row="2"
                                    Grid.Column="0"                                               
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>

                                <Slider x:Name="StarDistanceSlider"
                                    Grid.Row="2"
                                    Grid.Column="1"                                             
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Minimum="0"
                                    Maximum="1.0"                                        
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="0.01"
                                    Value="{Binding StarViewModel.LocalStarDistance}"/>

                                <TextBlock Text="Orbit"
                                    Grid.Row="3"
                                    Grid.Column="0"                                               
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>

                                <Slider x:Name="StarOrbitSlider"
                                    Grid.Row="3"
                                    Grid.Column="1"                                             
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Minimum="0"
                                    Maximum="1.0"                                        
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="0.01"
                                    Value="{Binding StarViewModel.LocalStarOrbit}"/>

                                <TextBlock Text="Plane"
                                    Grid.Row="4"
                                    Grid.Column="0"                                               
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>

                                <Slider x:Name="StarPlaneSlider"
                                    Grid.Row="4"
                                    Grid.Column="1"                                             
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Minimum="0"
                                    Maximum="1.0"                                        
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="0.01"
                                    Value="{Binding StarViewModel.LocalStarPlane}"/>

                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Text="Create Planet"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>
                                        
                                <Button
                                    Grid.Row="7"
                                    Grid.Column="1"                                       
                                    Style="{StaticResource FlatToolButton}"
                                    Width="120"
                                    Height="50"
                                    HorizontalAlignment="Left"
                                    Margin="3,3,3,3"
                                    ToolTip="Create Planet"
                                    Command="{Binding StarViewModel.CreateLocalStarCommand}">

                                    <materialDesign:PackIcon Kind="StarAddOutline"
                                        Width="36"
                                        Height="36"
                                        Foreground="LightSeaGreen"
                                        Opacity="0.7"/>
                                </Button>
                            </Grid>
                        </GroupBox>

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

            <!-- Animation properties -->
            <TabItem Header="Animation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <TextBlock
                            Text="Animation Settings"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6" />

                        <TextBlock
                            Text="Rotation, orbit, timing, and keyframe settings will appear here."
                            TextWrapping="Wrap"
                            Foreground="#FF77736D" />

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
