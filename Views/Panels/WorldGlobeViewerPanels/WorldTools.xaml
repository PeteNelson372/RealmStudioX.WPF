<UserControl x:Class="RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels.WorldTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"
             xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface" 
             mc:Ignorable="d" 
             d:DesignHeight="542" d:DesignWidth="300">

    <UserControl.Resources>
        <ScaleTransform x:Key="RadioScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
    </UserControl.Resources>
    
    <Grid DockPanel.Dock="Top" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="World Properties"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="10,4,0,8" />

        <TabControl x:Name="PropertiesTabs" Grid.Row="1" ItemContainerStyle="{StaticResource RoundedTabItemStyle}"   Background="#FFDFDBD2">

            <!-- World properties -->
            <TabItem Header="World">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">
                        <GroupBox Header="World" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,0,0,0">
                            <StackPanel Orientation="Vertical">
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                       Grid.Row="0"
                                       Grid.Column="0"                                       
                                       Text="Tilt Angle"
                                       VerticalAlignment="Center"
                                       Margin="10,0,8,6"/>

                                    <controls:NumericUpDown x:Name="TiltAngleBox"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Value="{Binding WorldTiltAngle}"
                                            HorizontalAlignment="Left"
                                            Minimum="0.0"
                                            Maximum="90.0"
                                            DecimalPlaces="2"
                                            Margin="0,0,6,6"
                                            Width="100"/>

                                    <TextBlock
                                       Grid.Row="1"
                                       Grid.Column="0"                                       
                                       Text="Current Axial Tilt"
                                       VerticalAlignment="Center"
                                       Margin="10,0,8,6"/>

                                    <TextBlock
                                       Grid.Row="1"
                                       Grid.Column="1"                                       
                                       Text="{Binding CurrentTiltAngle, StringFormat={}{0:F1}°}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,8,6"/>

                                    <TextBlock
                                       Grid.Row="2"
                                       Grid.Column="0"                                       
                                       Text="Rotation Direction"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,0"/>

                                    <StackPanel Orientation="Vertical" Grid.Row="2" Grid.Column="1" Margin="0,10,0,10">
                                        <RadioButton Content="Prograde (Earth)"
                                             Margin="0,4"
                                             GroupName="Rotation"
                                             IsChecked="{Binding RotationDirection, Mode=TwoWay,
                                                Converter={StaticResource EnumToBooleanConverter},
                                             ConverterParameter={x:Static rendering:WorldRotationDirection.Prograde}}"/>
                                        
                                        <RadioButton Content="Retrograde"
                                             Margin="0,4"
                                             GroupName="Rotation"
                                             IsChecked="{Binding RotationDirection, Mode=TwoWay,
                                                Converter={StaticResource EnumToBooleanConverter},
                                             ConverterParameter={x:Static rendering:WorldRotationDirection.Retrograde}}"/>

                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Rotation Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,0,8,6"/>

                                        <controls:NumericUpDown x:Name="RotationRateBox"
                                             Grid.Row="3" Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding RotationRate}"
                                             Minimum="0.1"
                                             Maximum="10.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,0,6,6"
                                             Width="100" />


                                    
                                </Grid>

                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                </ScrollViewer>
            </TabItem>

            <!-- Animation properties -->
            <TabItem Header="Animation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <TextBlock
                            Text="Animation Settings"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6" />

                        <TextBlock
                            Text="Rotation, orbit, timing, and keyframe settings will appear here."
                            TextWrapping="Wrap"
                            Foreground="#FF77736D" />

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
