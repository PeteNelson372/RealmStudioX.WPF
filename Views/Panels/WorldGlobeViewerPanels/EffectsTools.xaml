<UserControl x:Class="RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels.EffectsTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="300">

    <UserControl.Resources>

        <Style x:Key="FixedOrderTabControl" TargetType="{x:Type TabControl}">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                      SnapsToDevicePixels="True">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Headers remain in item order. -->
                            <WrapPanel Grid.Row="0"
                               IsItemsHost="True"
                               Orientation="Horizontal"
                               Margin="2,2,2,0"
                               Panel.ZIndex="1" />

                            <!-- Selected tab content. -->
                            <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">

                                <ContentPresenter
                                    x:Name="PART_SelectedContentHost"
                                    ContentSource="SelectedContent"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>    
    
    <Grid DockPanel.Dock="Top" Background="#FFDFDBD2">

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Effects"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="10,4,0,8" />

        <TabControl x:Name="PropertiesTabs" Grid.Row="2" ItemContainerStyle="{StaticResource RoundedTabItemStyle}"  Style="{StaticResource FixedOrderTabControl}" Background="#FFDFDBD2">

            <!-- Basic Effects properties -->
            <TabItem Header="Basic Effects">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <!-- Blur -->
                        <GroupBox Header="Blur" Margin="0,0,0,10" Padding="0,5,0,5">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                    <TextBlock
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Enable Blur"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,0,0,0"/>
                                    
                                    <CheckBox
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsChecked="{Binding EnableBlur, Mode=TwoWay}"
                                       Margin="0,0,0,0"
                                       Style="{StaticResource ToggleSwitchStyle}"
                                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Blur Amount"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,0"/>

                                <Slider
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                        Width="100"
                                        Margin="0,10,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding BlurAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                        </GroupBox>

                        <!-- Bleach Bypass -->
                        <GroupBox Header="Bleach Bypass" Margin="0,0,0,10"  Padding="0,5,0,5">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Enable Bleach Bypass"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,0,0,0"/>

                                <CheckBox
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsChecked="{Binding EnableBleachBypass, Mode=TwoWay}"
                                       Margin="0,0,0,0"
                                       Style="{StaticResource ToggleSwitchStyle}"
                                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Opacity"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,10"/>

                                <Slider
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                        Margin="0,10,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding BleachBypassOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>



                            </Grid>

                        </GroupBox>


                        <!-- Bloom -->
                        <GroupBox Header="Bloom" Margin="0,0,0,10" Padding="0,5,0,5">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Enable Bloom -->
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Enable Bloom"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"/>

                                <CheckBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding EnableBloom, Mode=TwoWay}"
                                    Style="{StaticResource ToggleSwitchStyle}"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <!-- Blur Width -->
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Blur Width"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="10,10,0,10"/>

                                <Slider
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                    Margin="0,10,0,0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding BloomBlurWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Intensity -->
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Intensity"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="10,10,0,10"/>

                                <Slider
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                    Margin="0,10,0,0"
                                    Minimum="0"
                                    Maximum="30"
                                    Value="{Binding BloomIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Halo Scale -->
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="Halo Scale"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="10,10,0,10"/>

                                <Slider
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                    Margin="0,10,0,0"
                                    Minimum="1"
                                    Maximum="5"
                                    Value="{Binding BloomHaloScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            </Grid>
                        </GroupBox>


                        <!-- Sepia -->
                        <GroupBox Header="Sepia" Margin="0,0,0,10"  Padding="0,5,0,5">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Enable Sepia"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,0,0,0"/>

                                <CheckBox
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsChecked="{Binding EnableSepia, Mode=TwoWay}"
                                       Margin="0,0,0,0"
                                       Style="{StaticResource ToggleSwitchStyle}"
                                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Sepia Amount"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,10"/>

                                <Slider
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                        Margin="0,10,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding SepiaAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            </Grid>

                        </GroupBox>

                        <!-- Grayscale -->
                        <GroupBox Header="Grayscale" Margin="0,0,0,10"  Padding="0,5,0,5">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Enable Grayscale"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,0,0,0"/>

                                <CheckBox
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsChecked="{Binding EnableGrayscale, Mode=TwoWay}"
                                       Margin="0,0,0,0"
                                       Style="{StaticResource ToggleSwitchStyle}"
                                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Desaturation"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,10"/>

                                <Slider
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                        Margin="0,10,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding DesaturationFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            </Grid>

                        </GroupBox>
                        
                    </StackPanel>

                </ScrollViewer>

            </TabItem>

            <!-- Basic Effects properties -->

            <TabItem Header="Special Effects">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <GroupBox Header="Lens Flare"
                      Margin="0,0,0,10"
                      Padding="0,5,0,5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Enable Lens Flare -->

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Enable Lens Flare"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>

                                <CheckBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding EnableLensFlare, Mode=TwoWay}"
                                    Style="{StaticResource ToggleSwitchStyle}"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <!-- Intensity -->

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Intensity"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,10"/>

                                <Slider
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    Margin="0,10,0,0"
                                    Minimum="0"
                                    Maximum="3"
                                    Value="{Binding LensFlareIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Glow Size -->

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Glow Size"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,10"/>

                                <Slider
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    Margin="0,10,0,0"
                                    Minimum="0.005"
                                    Maximum="0.15"
                                    Value="{Binding LensFlareGlowSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Streak Length -->

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="Streak Length"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,10"/>

                                <Slider
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    Margin="0,10,0,0"
                                    Minimum="0.05"
                                    Maximum="1.5"
                                    Value="{Binding LensFlareStreakLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Ghost Intensity -->

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Text="Ghost Intensity"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,10"/>

                                <Slider
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    Margin="0,10,0,0"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding LensFlareGhostIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Starburst Intensity -->

                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Text="Starburst Intensity"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,10"/>

                                <Slider
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    Margin="0,10,0,0"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding LensFlareStarburstIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            </Grid>

                        </GroupBox>

                        <GroupBox Header="Star Scintillation" Margin="0,0,0,10" Padding="0,5,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Enable -->
                                <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Enable"
                                   VerticalAlignment="Center"
                                   Margin="5"/>

                                <CheckBox Grid.Row="0"
                                      Grid.Column="1"
                                      IsChecked="{Binding EnableStarScintillation}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Margin="5"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <!-- Intensity -->
                                <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Intensity"
                                   VerticalAlignment="Center"
                                   Margin="5"/>

                                <Slider Grid.Row="1"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="2"
                                    Value="{Binding StarScintillationIntensity}"
                                    Style="{StaticResource ModernSlider}"
                                    VerticalAlignment="Center"
                                    Margin="5"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <!-- Speed -->
                                <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Speed"
                                   VerticalAlignment="Center"
                                   Margin="5"/>

                                <Slider Grid.Row="2"
                                    Grid.Column="1"
                                    Minimum="0.1"
                                    Maximum="4"
                                    Value="{Binding StarScintillationSpeed}"
                                    Style="{StaticResource ModernSlider}"
                                    VerticalAlignment="Center"
                                    Margin="5"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <!-- Brightness threshold -->
                                <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Brightness Threshold"
                                   VerticalAlignment="Center"
                                   Margin="5"/>

                                <Slider Grid.Row="3"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding StarScintillationThreshold}"
                                    Style="{StaticResource ModernSlider}"
                                    VerticalAlignment="Center"
                                    Margin="5"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <!-- Contrast threshold -->
                                <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Contrast Threshold"
                                   VerticalAlignment="Center"
                                   Margin="5"/>

                                <Slider Grid.Row="4"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding StarScintillationContrastThreshold}"
                                    Style="{StaticResource ModernSlider}"
                                    VerticalAlignment="Center"
                                    Margin="5"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="Maximum Star Size"
                                   VerticalAlignment="Center"
                                   Margin="5"/>

                                <Slider Grid.Row="5"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="8"
                                    Value="{Binding StarScintillationMaximumStarSize}"
                                    Style="{StaticResource ModernSlider}"
                                    VerticalAlignment="Center"
                                    Margin="5"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                            </Grid>
                        </GroupBox>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>


        </TabControl>

    </Grid>

</UserControl>
