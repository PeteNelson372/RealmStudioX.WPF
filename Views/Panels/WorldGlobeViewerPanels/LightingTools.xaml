<UserControl x:Class="RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels.LightingTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="542" d:DesignWidth="300">

    <UserControl.Resources>
        <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />

        <DataTemplate x:Key="EnumDescriptionTemplate">
            <TextBlock
            Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
        </DataTemplate>

        <Style x:Key="FixedOrderTabControl" TargetType="{x:Type TabControl}">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                      SnapsToDevicePixels="True">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Headers remain in item order. -->
                            <WrapPanel Grid.Row="0"
                               IsItemsHost="True"
                               Orientation="Horizontal"
                               Margin="2,2,2,0"
                               Panel.ZIndex="1" />

                            <!-- Selected tab content. -->
                            <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">

                                <ContentPresenter
                                    x:Name="PART_SelectedContentHost"
                                    ContentSource="SelectedContent"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid  DockPanel.Dock="Top" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock
            Grid.Row="0"
            Text="Scene Lighting Properties"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="10,4,0,8" />

        <TabControl x:Name="PropertiesTabs" Grid.Row="2" ItemContainerStyle="{StaticResource RoundedTabItemStyle}"  Style="{StaticResource FixedOrderTabControl}" Background="#FFDFDBD2">
            <!-- Texture properties -->
            <TabItem Header="Lighting">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <GroupBox Header="Ambient Lighting" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="10,10,10,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Enable"
                                    Grid.Row="0"
                                    Grid.Column="0"                                               
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>

                                <CheckBox x:Name="EnableAmbientLightingCheckBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  ToolTip="Enable Ambient Lighting"
                                  IsChecked="{Binding LightingModel.EnableAmbientLight, Mode=TwoWay}"
                                    Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                

                                <TextBlock Text="Color"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>
                                
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource FlatToolButton}"
                                    Width="120"
                                    Height="40"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Background="{Binding LightingModel.AmbientLightColorBrush}"
                                    ToolTip="Select Ambient Light Color"
                                    PreviewMouseLeftButtonUp="AmbientLightColor_LeftClick"
                                    PreviewMouseRightButtonUp="AmbientLightColor_RightClick">
                                    
                                    <materialDesign:PackIcon Kind="PaletteOutline"
                                        Width="30" Height="30"
                                        Foreground="Tan" Opacity="0.7"/>
                                </Button>

                                <TextBlock Text="Intensity"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>

                                <Slider x:Name="AmbientLightIntensitySlider"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0"
                                    Maximum="1"
                                    SmallChange="0.01"
                                    LargeChange="0.1"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="False"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"                                        
                                    Value="{Binding LightingModel.AmbientLightIntensity, Mode=TwoWay}"
                                    ToolTip="{Binding LightingModel.AmbientLightIntensity, StringFormat={}{0:P0}}"/>

                            </Grid>
                        </GroupBox>

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

            <!-- Animation properties -->
            <TabItem Header="Animation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <TextBlock
                            Text="Animation Settings"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6" />

                        <TextBlock
                            Text="Rotation, orbit, timing, and keyframe settings will appear here."
                            TextWrapping="Wrap"
                            Foreground="#FF77736D" />

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
