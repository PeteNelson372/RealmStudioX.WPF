                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,10,0,0"
                                  IsChecked="{Binding CreateMoonModel.MoonCoronaModel.EnableFlares, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Intensity"
                                   VerticalAlignment="Center"
                                   Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="CoronaActivityIntensityBox"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Value="{Binding CreateMoonModel.MoonCoronaModel.ActivityIntensity, Mode=TwoWay}"
                                        Minimum="0.0"
                                        Maximum="2.0"
                                        Increment="0.01"
                                        DecimalPlaces="2"
                                        Margin="0,10,0,0"
                                        Width="100"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Frequency (per min)"
                                   VerticalAlignment="Center"
                                   Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="CoronaActivityFrequencyBox"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Value="{Binding CreateMoonModel.MoonCoronaModel.ActivityFrequency, Mode=TwoWay}"
                                    Minimum="0.0"
                                    Maximum="30.0"
                                    Increment="0.5"
                                    DecimalPlaces="1"
                                    Margin="0,10,0,0"
                                    Width="100"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Geometry Scale"
                                   VerticalAlignment="Center"
                                   Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="CoronaActivityGeometryScaleBox"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Value="{Binding CreateMoonModel.MoonCoronaModel.ActivityGeometryScale, Mode=TwoWay}"
                                        Minimum="0.1"
                                        Maximum="1.0"
                                        Increment="0.01"
                                        DecimalPlaces="2"
                                        Margin="0,10,0,0"
                                        Width="100"/>

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="Thickness Scale"
                                   VerticalAlignment="Center"
                                   Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="CoronaActivityThicknessScaleBox"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Value="{Binding CreateMoonModel.MoonCoronaModel.ActivityThicknessScale, Mode=TwoWay}"
                                        Minimum="0.5"
                                        Maximum="2.0"
                                        Increment="0.01"
                                        DecimalPlaces="2"
                                        Margin="0,10,0,0"
                                        Width="100"/>
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Black Hole">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <GroupBox Header="Plasma Jets" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,10,0,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                    Text="Enable Plasma Jets"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>

                                <CheckBox x:Name="EnableJetsCheckBox"
                                  Grid.Row="0" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding CreateMoonModel.MoonBlackHoleModel.EnableJets, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Jet Length"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetLengthBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonBlackHoleModel.JetLength, Mode=TwoWay}"
                                             Minimum="0.1"
                                             Maximum="30.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />


                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Jet Pulse Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetPulseRateBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonBlackHoleModel.JetPulseRate, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="2.0"
                                             Increment="0.001"
                                             DecimalPlaces="3"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                    Text="Enable Jet Particles"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>

                                <CheckBox x:Name="EnableJetParticlesCheckBox"
                                  Grid.Row="3" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,10,0,0"
                                  IsChecked="{Binding CreateMoonModel.MoonBlackHoleModel.EnableJetParticles, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="Particle Emission Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetParticleEmissionRateBox"
                                             Grid.Row="4"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonBlackHoleModel.JetParticleEmissionRate, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="60.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           Text="Particle Lifetime"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetParticleLifetimeBox"
                                             Grid.Row="5"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonBlackHoleModel.JetParticleLifetime, Mode=TwoWay}"
                                             Minimum="0.1"
                                             Maximum="20.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           Text="Particle Dispersion"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetParticleDispersionBox"
                                             Grid.Row="6"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonBlackHoleModel.JetParticleDispersion, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="4.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="7" Grid.Column="0"
                                           Text="Particle Speed"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetParticleSpeedBox"
                                             Grid.Row="7"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonBlackHoleModel.JetParticleSpeed, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="20.0"
                                             Increment="0.005"
                                             DecimalPlaces="3"
                                             Margin="0,10,0,0"
                                             Width="100" />

                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Accretion Disk" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,10,0,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <TextBlock Grid.Row="0" Grid.Column="0"
                                    Text="Enable Disk Particles"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>

                                <CheckBox x:Name="EnableDiskParticlesCheckBox"
                                  Grid.Row="0" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,10,0,0"
                                  IsChecked="{Binding CreateMoonModel.MoonBlackHoleModel.EnableDiskParticles, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Particle Emission Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="DiskParticleEmissionRateBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonBlackHoleModel.DiskParticleEmissionRate, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="40.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Particle Lifetime"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="DiskParticleLifetimeBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonBlackHoleModel.DiskParticleLifetime, Mode=TwoWay}"
                                             Minimum="0.1"
                                             Maximum="20.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Particle Outflow Speed"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="DiskParticleSpeedBox"
                                             Grid.Row="3"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonBlackHoleModel.DiskParticleOutflowSpeed, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="5.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
