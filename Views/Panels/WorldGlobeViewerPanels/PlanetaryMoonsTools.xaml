<UserControl x:Class="RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels.PlanetaryMoonsTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="300">

    <UserControl.Resources>
        <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />

        <DataTemplate x:Key="EnumDescriptionTemplate">
            <TextBlock
            Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
        </DataTemplate>

        <Style x:Key="FixedOrderTabControl" TargetType="{x:Type TabControl}">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                      SnapsToDevicePixels="True">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Headers remain in item order. -->
                            <WrapPanel Grid.Row="0"
                               IsItemsHost="True"
                               Orientation="Horizontal"
                               Margin="2,2,2,0"
                               Panel.ZIndex="1" />

                            <!-- Selected tab content. -->
                            <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">

                                <ContentPresenter
                                    x:Name="PART_SelectedContentHost"
                                    ContentSource="SelectedContent"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid DockPanel.Dock="Top" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="Moon Properties"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="10,4,0,8" />

        <TabControl x:Name="PropertiesTabs" Grid.Row="2" ItemContainerStyle="{StaticResource RoundedTabItemStyle}"  Style="{StaticResource FixedOrderTabControl}" Background="#FFDFDBD2">

            <!-- Texture properties -->
            <TabItem Header="Moon">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <GroupBox Header="Moon Name and Description"
          Height="Auto"
          HorizontalAlignment="Stretch"
          Margin="0,0,0,0"
          Padding="0,10,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <TextBlock Text="Name"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,0,0,0"/>

                                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch">
                                    
                                <TextBox
                                    Width="115"
                                    Margin="0"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding CreateMoonModel.MoonName, UpdateSourceTrigger=PropertyChanged}"/>

                                   
                                    <Button
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,0,0"
                                        Style="{StaticResource FlatToolButton}"
                                        Command="{Binding CreateMoonModel.GenerateMoonNameCommand}"
                                        ToolTip="Generate a random moon name.">
                                                <materialDesign:PackIcon Kind="RenameOutline"
                                                        Width="12"
                                                        Height="12"
                                                        HorizontalAlignment="Center"
                                                        Opacity="0.7">
                                                </materialDesign:PackIcon>
                                    </Button>
                                    <Button
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,0,0"
                                        Style="{StaticResource FlatToolButton}"
                                        Command="{Binding CreateMoonModel.LockMoonNameCommand}"
                                        ToolTip="Lock or unlock the moon name for random generation.">

                                        <materialDesign:PackIcon
                                            Width="12"
                                            Height="12"
                                            Opacity="0.7">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Kind" Value="LockOpen"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CreateMoonModel.MoonNameLocked}" Value="True">
                                                            <Setter Property="Kind" Value="Lock"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="Description"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Foreground="#FF45443F"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Margin="10,5,0,0"/>

                                <Button Grid.Row="2"
                                    Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource FlatToolButton}"
                                    Command="{Binding CreateMoonModel.GenerateMoonDescriptionCommand}"
                                    ToolTip="Generate a moon description using the AI assistant.">
                                    <svgc:SvgViewbox Source="/Assets/svg/OAI_OpenAI-Blossom_Black.svg" Width="22" Height="22"/>
                                </Button>

                                <Button Grid.Row="3"
                                    Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource FlatToolButton}"
                                    Command="{Binding CreateMoonModel.SetMoonCharacteristicsCommand}"
                                    ToolTip="Set the type and characteristics used to generate the moon description.">
                                        <materialDesign:PackIcon Kind="MapLegend"
                                         Foreground="SaddleBrown"
                                         HorizontalAlignment="Center"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <Button Grid.Row="4"
                                    Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource FlatToolButton}"
                                    Command="{Binding CreateMoonModel.CreateMoonArticleCommand}"
                                    ToolTip="Create and upload a World Anvil article for this moon.">
                                        <materialDesign:PackIcon Kind="FileUpload"
                                         Foreground="#FF8C0A0A"
                                         HorizontalAlignment="Center"
                                         Width="24"
                                         Height="24"
                                         Opacity="0.7"/>
                                </Button>

                                <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     Grid.RowSpan="4"
                                     Margin="0,5,0,0"
                                     Height="120"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding CreateMoonModel.MoonDescription,
                                                    UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Create Moon" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="10,10,10,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Moon Type"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"/>

                                <ComboBox x:Name="MoonTypeCombo"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Width="120"
                                    Height="26"
                                    Background="#FFDFDBD2"
                                    ItemsSource="{Binding CreateMoonModel.MoonTypes}"
                                    SelectedItem="{Binding CreateMoonModel.SelectedMoonType, Mode=TwoWay}"
                                    ItemTemplate="{StaticResource EnumDescriptionTemplate}" />

                                <TextBlock Text="Color"
                                    Grid.Row="1" Grid.Column="0"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>
                                <Button Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource FlatToolButton}"
                                    Width="120" Height="40"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Background="{Binding CreateMoonModel.MoonColorBrush}"
                                    ToolTip="Select Moon Color"
                                    PreviewMouseLeftButtonUp="MoonColor_LeftClick"
                                    PreviewMouseRightButtonUp="MoonColor_RightClick">
                                    <materialDesign:PackIcon Kind="PaletteOutline"
                                        Width="30" Height="30"
                                        Foreground="Tan" Opacity="0.7"/>
                                </Button>


                                <TextBlock Text="Size"
                                    Grid.Row="2"
                                    Grid.Column="0"                                               
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>

                                <Slider x:Name="MoonSizeSlider"
                                    Grid.Row="2"
                                    Grid.Column="1"                                             
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Minimum="0.01"
                                    Maximum="1.0"                                        
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="0.01"
                                    Value="{Binding CreateMoonModel.MoonSize}"/>


                                <TextBlock Text="X Position"
                                    Grid.Row="3" Grid.Column="0"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>
                                <Slider x:Name="MoonXSlider"
                                    Grid.Row="3" Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                    Width="120" HorizontalAlignment="Left"
                                    Minimum="-10.0" Maximum="10.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    SmallChange="0.1"
                                    Value="{Binding CreateMoonModel.MoonX}"/>

                                <TextBlock Text="Y Position"
                                    Grid.Row="4" Grid.Column="0"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>
                                <Slider x:Name="MoonYSlider"
                                    Grid.Row="4" Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                    Width="120" HorizontalAlignment="Left"
                                    Minimum="-10.0" Maximum="10.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    SmallChange="0.1"
                                    Value="{Binding CreateMoonModel.MoonY}"/>

                                <TextBlock Text="Z Position"
                                    Grid.Row="5" Grid.Column="0"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>
                                <Slider x:Name="MoonZSlider"
                                    Grid.Row="5" Grid.Column="1"
                                    Style="{StaticResource ModernSlider}"
                                    behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                    Width="120" HorizontalAlignment="Left"
                                    Minimum="-10.0" Maximum="10.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    SmallChange="0.1"
                                    Value="{Binding CreateMoonModel.MoonZ}"/>

                                <TextBlock
                                       Grid.Row="6"
                                       Grid.Column="0"                                       
                                       Text="Axial Tilt"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>

                                <controls:NumericUpDown x:Name="MoonTiltAngleBox"
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Value="{Binding CreateMoonModel.AxialTilt}"
                                            HorizontalAlignment="Left"
                                            Minimum="0.0"
                                            Maximum="90.0"
                                            Increment="0.1"
                                            DecimalPlaces="1"
                                            Margin="0,10,0,0"
                                            Width="100"/>

                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Text="Create Moon"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>

                                <Button
                                    Grid.Row="7"
                                    Grid.Column="1"                                       
                                    Style="{StaticResource FlatToolButton}"
                                    Width="120"
                                    Height="50"
                                    HorizontalAlignment="Left"
                                    Margin="3,3,3,3"
                                    ToolTip="Create Moon"
                                    Command="{Binding CreateMoonModel.CreateMoonCommand}">

                                    <materialDesign:PackIcon Kind="AddCircle"
                                        Width="36"
                                        Height="36"
                                        Foreground="LightSeaGreen"
                                        Opacity="0.7"/>
                                </Button>
                            </Grid>
                        </GroupBox>

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

            <!-- Animation properties -->
            <TabItem Header="Animation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">
                        <GroupBox Header="Moon Animation" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="0,0,0,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                       Grid.Row="0"
                                       Grid.Column="0"                                       
                                       Text="Rotation Direction"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,0"/>

                                <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1" Margin="0,10,0,10">
                                    <RadioButton Content="Prograde"
                                             Margin="0,4"
                                             IsChecked="{Binding CreateMoonModel.MoonRotationDirection, Mode=TwoWay,
                                                Converter={StaticResource EnumToBooleanConverter},
                                             ConverterParameter={x:Static rendering:WorldRotationDirection.Prograde}}"/>

                                    <RadioButton Content="Retrograde"
                                             Margin="0,4"
                                             IsChecked="{Binding CreateMoonModel.MoonRotationDirection, Mode=TwoWay,
                                                Converter={StaticResource EnumToBooleanConverter},
                                             ConverterParameter={x:Static rendering:WorldRotationDirection.Retrograde}}"/>

                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Rotation Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,0,8,6"/>

                                <controls:NumericUpDown x:Name="RotationRateBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding CreateMoonModel.MoonRotationRate}"
                                             Minimum="0.1"
                                             Maximum="10.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,0,6,6"
                                             Width="100" />

                            </Grid>
                        </GroupBox>

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

            <TabItem Header="Terrestrial">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <GroupBox Header="Terrestrial Planet" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0"  Padding="0,10,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Texture"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"/>

                                <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource FlatToolButton}"
                                        Width="Auto"
                                        Height="Auto"
                                        Margin="3,3,3,3"
                                        HorizontalAlignment="Center"
                                        ToolTip="Select Moon Texture File"
                                        Command="{Binding CreateMoonModel.SelectMoonTextureFileCommand}">

                                    <materialDesign:PackIcon Kind="FileImageAddOutline"
                                            Width="36"
                                            Height="36"
                                            Opacity="0.7"/>
                                </Button>

                                <!-- Select a map to use as the moon texture -->

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Project Map"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"/>

                                <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource FlatToolButton}"
                                        Width="Auto"
                                        Height="Auto"
                                        Margin="3,3,3,3"
                                        HorizontalAlignment="Center"
                                        ToolTip="Select Project Map"
                                        Command="{Binding CreateMoonModel.SelectMoonMapTextureCommand}">

                                    <materialDesign:PackIcon Kind="MapAdd"
                                            Width="36"
                                            Height="36"
                                            Opacity="0.7"/>
                                </Button>

                            </Grid>

                        </GroupBox>

                        <GroupBox Header="Planetary Rings"
                              HorizontalAlignment="Stretch"
                              Margin="0,10,0,0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Texture"
                                       Foreground="#FF45443F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,0"/>

                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource FlatToolButton}"
                                        Width="Auto"
                                        Height="Auto"
                                        Margin="3"
                                        HorizontalAlignment="Center"
                                        ToolTip="Select Rings Texture File"
                                        Command="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.SelectTextureFileCommand}">

                                    <materialDesign:PackIcon Kind="FileImageAddOutline"
                                         Width="36"
                                         Height="36"
                                         Opacity="0.7"/>
                                </Button>

                                <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Enable Rings"
                                       VerticalAlignment="Center"
                                       Margin="10,10,0,0"/>

                                <CheckBox Grid.Row="1"
                                      Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.Enabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Inner Radius"
                                       VerticalAlignment="Center"
                                       Margin="10,10,0,0"/>

                                <controls:NumericUpDown Grid.Row="2"
                                        Grid.Column="1"
                                        Value="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.InnerRadiusScale}"
                                        Minimum="1.01"
                                        Maximum="9.99"
                                        Increment="0.01"
                                        DecimalPlaces="2"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        IsEnabled="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.Enabled}"/>

                                <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Outer Radius"
                                       VerticalAlignment="Center"
                                       Margin="10,10,0,0"/>

                                <controls:NumericUpDown Grid.Row="3"
                                        Grid.Column="1"
                                        Value="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.OuterRadiusScale}"
                                        Minimum="1.02"
                                        Maximum="10.0"
                                        Increment="0.01"
                                        DecimalPlaces="2"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        IsEnabled="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.Enabled}"/>

                                <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Inclination"
                                       VerticalAlignment="Center"
                                       Margin="10,10,0,0"/>

                                <controls:NumericUpDown Grid.Row="4"
                                        Grid.Column="1"
                                        Value="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.Inclination}"
                                        Minimum="-90"
                                        Maximum="90"
                                        Increment="0.1"
                                        DecimalPlaces="1"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        IsEnabled="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.Enabled}"/>

                                <!-- Enable Ring Turbulence -->
                                <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="Enable Turbulence"
                                       VerticalAlignment="Center"
                                       Margin="10,10,0,0"/>

                                <CheckBox Grid.Row="5"
                                      Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.EnableTurbulence,
                                                          Mode=TwoWay}"
                                      IsEnabled="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.Enabled}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <!-- Ring Turbulence Intensity -->
                                <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="Turbulence Intensity"
                                       VerticalAlignment="Center"
                                       Margin="10,10,0,0"/>

                                <controls:NumericUpDown Grid.Row="6"
                                        Grid.Column="1"
                                        Value="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.TurbulenceIntensity,
                                                        Mode=TwoWay}"
                                        Minimum="0.0"
                                        Maximum="1.0"
                                        Increment="0.01"
                                        DecimalPlaces="2"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        IsEnabled="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.Enabled}"/>

                                <!-- Enable Ring Rotation -->
                                <TextBlock Grid.Row="7"
                                       Grid.Column="0"
                                       Text="Enable Rotation"
                                       VerticalAlignment="Center"
                                       Margin="10,10,0,0"/>

                                <CheckBox Grid.Row="7"
                                      Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.EnableRotation, Mode=TwoWay}"
                                      IsEnabled="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.Enabled}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <!-- Ring Rotation Rate -->
                                <TextBlock Grid.Row="8"
                                        Grid.Column="0"
                                        Text="Rotation Rate"
                                        VerticalAlignment="Center"
                                        Margin="10,10,0,0"/>

                                <controls:NumericUpDown Grid.Row="8"
                                        Grid.Column="1"
                                        Value="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.RotationRate, Mode=TwoWay}"
                                        Minimum="0.0"
                                        Maximum="10.0"
                                        Increment="0.1"
                                        DecimalPlaces="1"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        IsEnabled="{Binding CreateMoonModel.MoonTerrestrialModel.Rings.Enabled}"/>

                                <!-- Ring Rotation Direction -->
                                <TextBlock
                                       Grid.Row="9"
                                       Grid.Column="0"                                       
                                       Text="Rotation Direction"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,0"/>

