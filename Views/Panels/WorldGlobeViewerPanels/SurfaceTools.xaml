<UserControl x:Class="RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels.SurfaceTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"              
             mc:Ignorable="d" 
             d:DesignHeight="542" d:DesignWidth="300">

    <Grid DockPanel.Dock="Top" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="World Surface Properties"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="10,4,0,8" />

        <TabControl x:Name="PropertiesTabs" Grid.Row="1" ItemContainerStyle="{StaticResource RoundedTabItemStyle}"  Background="#FFDFDBD2">

            <!-- Texture properties -->
            <TabItem Header="Surface">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    

                    <StackPanel Margin="10">
                        <GroupBox Header="World Surface" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Select Texture"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="3,20,3,3"/>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource FlatToolButton}"
                                    Width="Auto"
                                    Height="Auto"
                                    Margin="3,3,3,3"
                                    HorizontalAlignment="left"
                                    ToolTip="Select Texture File"
                                    Command="{Binding SelectTextureFileCommand}">
                                    <materialDesign:PackIcon Kind="FileImageAddOutline"
                                            Width="36"
                                            Height="36"
                                            Opacity="0.7"/>
                                </Button>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Clear Texture"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="3,3,3,3"/>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource FlatToolButton}"
                                    Width="Auto"
                                    Height="Auto"
                                    Margin="3,3,3,3"
                                    HorizontalAlignment="Left"
                                    ToolTip="Select Import File"
                                    Command="{Binding ClearTextureCommand}">
                                    <materialDesign:PackIcon Kind="FileImageMinusOutline"
                                            Width="36"
                                            Height="36"
                                            Opacity="0.7"/>
                                </Button>
                            </Grid>
                        </GroupBox>

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

            <!-- Animation properties -->
            <TabItem Header="Animation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <TextBlock
                            Text="Animation Settings"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6" />

                        <TextBlock
                            Text="Rotation, orbit, timing, and keyframe settings will appear here."
                            TextWrapping="Wrap"
                            Foreground="#FF77736D" />

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
