<UserControl x:Class="RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels.LocalStarTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels.WorldGlobeViewerPanels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"               
             mc:Ignorable="d" 
             d:DesignHeight="642" d:DesignWidth="300">

    <UserControl.Resources>
        <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />

        <DataTemplate x:Key="EnumDescriptionTemplate">
            <TextBlock
            Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
        </DataTemplate>

        <Style x:Key="FixedOrderTabControl" TargetType="{x:Type TabControl}">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                      SnapsToDevicePixels="True">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Headers remain in item order. -->
                            <WrapPanel Grid.Row="0"
                               IsItemsHost="True"
                               Orientation="Horizontal"
                               Margin="2,2,2,0"
                               Panel.ZIndex="1" />

                            <!-- Selected tab content. -->
                            <Border Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">

                                <ContentPresenter
                            x:Name="PART_SelectedContentHost"
                            ContentSource="SelectedContent"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid DockPanel.Dock="Top" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="Local Star Properties"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="10,4,0,8" />


        <TabControl x:Name="PropertiesTabs" Grid.Row="1" ItemContainerStyle="{StaticResource RoundedTabItemStyle}"  Style="{StaticResource FixedOrderTabControl}" Background="#FFDFDBD2">

            <!-- local star properties -->
            <TabItem Header="Local Star">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Width="Auto"
                            Height="Auto"
                            Margin="0,0,0,0">

                            <CheckBox x:Name="EnableLocalStarCheckBox"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding StarViewModel.EnableLocalStar, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                            <TextBlock Text="Show Local Star"
                                Foreground="#FF45443F"
                                VerticalAlignment="Center"
                                Margin="4,0,10,0"/>
                        </StackPanel>

                        <GroupBox Header="Local Star" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,0,0,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Local Star Type"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="10,3,3,3"/>

                                <ComboBox x:Name="LocalStarTypeCombo"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      Width="120"
                                      Height="26"
                                      Background="#FFDFDBD2"
                                      ItemsSource="{Binding StarViewModel.LocalStarTypes}"
                                      SelectedItem="{Binding StarViewModel.SelectedLocalStarType, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource EnumDescriptionTemplate}" />

                                <TextBlock Text="Size"
                                        Grid.Row="1"
                                        Grid.Column="0"                                               
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,10,0,0"/>

                                <Slider x:Name="StarSizeSlider"
                                        Grid.Row="1"
                                        Grid.Column="1"                                             
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Minimum="0.01"
                                        Maximum="1.0"                                        
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="0.01"
                                        Value="{Binding StarViewModel.LocalStarSize}"/>


                                <TextBlock Text="Distance"
                                        Grid.Row="2"
                                        Grid.Column="0"                                               
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>

                                <Slider x:Name="StarDistanceSlider"
                                        Grid.Row="2"
                                        Grid.Column="1"                                             
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Minimum="0"
                                        Maximum="1.0"                                        
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="0.01"
                                        Value="{Binding StarViewModel.LocalStarDistance}"/>

                                <TextBlock Text="Orbit"
                                        Grid.Row="3"
                                        Grid.Column="0"                                               
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>

                                <Slider x:Name="StarOrbitSlider"
                                        Grid.Row="3"
                                        Grid.Column="1"                                             
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Minimum="0"
                                        Maximum="1.0"                                        
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="0.01"
                                        Value="{Binding StarViewModel.LocalStarOrbit}"/>

                                <TextBlock Text="Plane"
                                        Grid.Row="4"
                                        Grid.Column="0"                                               
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>

                                <Slider x:Name="StarPlaneSlider"
                                        Grid.Row="4"
                                        Grid.Column="1"                                             
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Minimum="0"
                                        Maximum="1.0"                                        
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="0.01"
                                        Value="{Binding StarViewModel.LocalStarPlane}"/>

                                <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Text="Star Light Color"
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>
                                <Button
                                        Grid.Row="5"
                                        Grid.Column="1"                                       
                                        Style="{StaticResource FlatToolButton}"
                                        Width="120"
                                        Height="50"
                                        HorizontalAlignment="Left"
                                        Margin="3,3,3,3"
                                        Background="{Binding StarViewModel.StarlightColorBrush}"
                                        ToolTip="Select Starlight Color"
                                        PreviewMouseLeftButtonUp="StarlightColor_LeftClick"
                                        PreviewMouseRightButtonUp="StarlightColor_RightClick">

                                    <materialDesign:PackIcon Kind="PaletteOutline"
                                            Width="36"
                                            Height="36"
                                            Foreground="Tan"
                                            Opacity="0.7"/>
                                </Button>

                                <TextBlock Text="Light Intensity"
                                        Grid.Row="6"
                                        Grid.Column="0"                                               
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>

                                <Slider x:Name="StarLightIntensitySlider"
                                        Grid.Row="6"
                                        Grid.Column="1"                                             
                                        Style="{StaticResource ModernSlider}"
                                        behaviors:SliderToolTipBehavior.EnableFormattedToolTip="True"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Minimum="0"
                                        Maximum="1.0"                                        
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="0.01"
                                        Value="{Binding StarViewModel.LocalStarlightIntensity}"/>

                                <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Text="Create Local Star"
                                        Foreground="#FF45443F"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>
                                <Button
                                        Grid.Row="7"
                                        Grid.Column="1"                                       
                                        Style="{StaticResource FlatToolButton}"
                                        Width="120"
                                        Height="50"
                                        HorizontalAlignment="Left"
                                        Margin="3,3,3,3"
                                        ToolTip="Create Local Star"
                                        Command="{Binding StarViewModel.CreateLocalStarCommand}">

                                    <materialDesign:PackIcon Kind="StarAddOutline"
                                            Width="36"
                                            Height="36"
                                            Foreground="LightSeaGreen"
                                            Opacity="0.7"/>
                                </Button>
                            </Grid>
                        </GroupBox>
                    </StackPanel>


                </ScrollViewer>
            </TabItem>

            <!-- Animation properties -->
            <TabItem Header="Animation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <GroupBox Header="Local Star Animation" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,0,0,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                       Grid.Row="0"
                                       Grid.Column="0"                                       
                                       Text="Rotation Direction"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left"
                                       Margin="10,10,0,0"/>

                                <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1" Margin="0,10,0,10">
                                    <RadioButton Content="Prograde"
                                             Margin="0,4"
                                             GroupName="Rotation"
                                             IsChecked="{Binding StarViewModel.LocalStarRotationDirection, Mode=TwoWay,
                                                Converter={StaticResource EnumToBooleanConverter},
                                             ConverterParameter={x:Static rendering:WorldRotationDirection.Prograde}}"/>

                                    <RadioButton Content="Retrograde"
                                             Margin="0,4"
                                             GroupName="Rotation"
                                             IsChecked="{Binding StarViewModel.LocalStarRotationDirection, Mode=TwoWay,
                                                Converter={StaticResource EnumToBooleanConverter},
                                             ConverterParameter={x:Static rendering:WorldRotationDirection.Retrograde}}"/>

                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Rotation Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,0,8,6"/>

                                <controls:NumericUpDown x:Name="RotationRateBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding StarViewModel.LocalStarRotationRate}"
                                             Minimum="0.1"
                                             Maximum="10.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,0,6,6"
                                             Width="100" />

                            </Grid>
                        </GroupBox>

                    </StackPanel>

                </ScrollViewer>
            </TabItem>

            <TabItem Header="Nebula">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Gas Giant">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Corona">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Black Hole">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <GroupBox Header="Plasma Jets" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,10,0,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                    Text="Enable Plasma Jets"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"/>

                                <CheckBox x:Name="EnableJetsCheckBox"
                                  Grid.Row="0" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding BlackHoleModel.EnableJets, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Jet Length"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetLengthBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding BlackHoleModel.JetLength, Mode=TwoWay}"
                                             Minimum="0.1"
                                             Maximum="30.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />


                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Jet Pulse Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetPulseRateBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding BlackHoleModel.JetPulseRate, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="2.0"
                                             Increment="0.001"
                                             DecimalPlaces="3"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                    Text="Enable Jet Particles"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>

                                <CheckBox x:Name="EnableJetParticlesCheckBox"
                                  Grid.Row="3" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,10,0,0"
                                  IsChecked="{Binding BlackHoleModel.EnableJetParticles, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="Particle Emission Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetParticleEmissionRateBox"
                                             Grid.Row="4"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding BlackHoleModel.JetParticleEmissionRate, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="60.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           Text="Particle Lifetime"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetParticleLifetimeBox"
                                             Grid.Row="5"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding BlackHoleModel.JetParticleLifetime, Mode=TwoWay}"
                                             Minimum="0.1"
                                             Maximum="20.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           Text="Particle Dispersion"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetParticleDispersionBox"
                                             Grid.Row="6"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding BlackHoleModel.JetParticleDispersion, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="4.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="7" Grid.Column="0"
                                           Text="Particle Speed"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="JetParticleSpeedBox"
                                             Grid.Row="7"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding BlackHoleModel.JetParticleSpeed, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="20.0"
                                             Increment="0.005"
                                             DecimalPlaces="3"
                                             Margin="0,10,0,0"
                                             Width="100" />

                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Accretion Disk" Height="Auto"  HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,10,0,10">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <TextBlock Grid.Row="0" Grid.Column="0"
                                    Text="Enable Disk Particles"
                                    Foreground="#FF45443F"
                                    VerticalAlignment="Center"
                                    Margin="10,10,0,0"/>

                                <CheckBox x:Name="EnableDiskParticlesCheckBox"
                                  Grid.Row="0" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,10,0,0"
                                  IsChecked="{Binding BlackHoleModel.EnableDiskParticles, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Particle Emission Rate"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="DiskParticleEmissionRateBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding BlackHoleModel.DiskParticleEmissionRate, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="40.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Particle Lifetime"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="DiskParticleLifetimeBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding BlackHoleModel.DiskParticleLifetime, Mode=TwoWay}"
                                             Minimum="0.1"
                                             Maximum="20.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Particle Outflow Speed"
                                           VerticalAlignment="Center"
                                           Margin="10,10,0,0"/>

                                <controls:NumericUpDown x:Name="DiskParticleSpeedBox"
                                             Grid.Row="3"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             Value="{Binding BlackHoleModel.DiskParticleOutflowSpeed, Mode=TwoWay}"
                                             Minimum="0.0"
                                             Maximum="5.0"
                                             Increment="0.1"
                                             DecimalPlaces="2"
                                             Margin="0,10,0,0"
                                             Width="100" />
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
