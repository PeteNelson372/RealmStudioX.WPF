<UserControl x:Class="RealmStudioX.WPF.Views.Panels.HeightMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:RealmStudioX.WPF.Views.Panels"
             xmlns:controls="clr-namespace:RealmStudioX.WPF.Views.Controls"
             xmlns:behaviors="clr-namespace:RealmStudioX.WPF.Editor.Behaviors"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:rendering="clr-namespace:RealmStudioShapeRenderingLib;assembly=RealmStudioShapeRenderingLib"
             mc:Ignorable="d" 
             d:DesignHeight="916" d:DesignWidth="235">

    <UserControl.Resources>
        <conv:SKColorToBrushConverter x:Key="SKColorToBrushConverter"/>
    </UserControl.Resources>

    <Grid Visibility="Visible" Background="#FFDFDBD2">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="72"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="1" Grid.Column="1">

            <controls:HeightMapControls Visibility="Visible"/>

        </Grid>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Orientation="Vertical"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Width="140"
            Height="Auto"
            Margin="15,40,0,0">

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Minimum Height"
                    VerticalAlignment="Center"
                    Margin="0,0,8,6"/>
            
                <Grid Grid.Column="1">
                    <controls:NumericUpDown x:Name="MinHeightBox"
                                         Value="{Binding MinimumHeight}"
                                         Minimum="-5000"
                                         Maximum="1000"
                                         Margin="0,0,6,6"
                                         Width="120"/>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,10,8,6">
                
                <TextBlock Text="Maximum Height"
                    VerticalAlignment="Center"
                    Margin="0,0,0,6"/>

                <Grid Grid.Column="1">
                    <controls:NumericUpDown x:Name="MaxHeightBox"
                                         Value="{Binding MaximumHeight}"
                                         Minimum="1000"
                                         Maximum="50000"
                                         Margin="0,0,6,6"
                                         Width="120"/>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Vertical">

                <TextBlock Text="Height Units"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,6"/>

                <ComboBox x:Name="UnitsCombo"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  Width="120"
                                  Margin="0,0,0,6"
                                  Background="#FFDFDBD2"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding HeightUnit, Mode=TwoWay}">
                    <!-- Default = Meters -->

                    <ComboBoxItem Content="Centimeters"/>
                    <ComboBoxItem Content="Inches"/>
                    <ComboBoxItem Content="Feet"/>
                    <ComboBoxItem Content="Yards"/>
                    <ComboBoxItem Content="Meters"/>
                    <ComboBoxItem Content="Kilometers"/>
                    <ComboBoxItem Content="Miles"/>
                    <ComboBoxItem Content="Astronomical Units (AU)"/>
                    <ComboBoxItem Content="Light Years"/>
                    <ComboBoxItem Content="Parsecs"/>

                </ComboBox>

            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Grid.Column="0"
                Orientation="Vertical"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Width="140"
                Height="Auto"
                Margin="0,40,0,0">

                <TextBlock Text="Height Map Colors"
                        VerticalAlignment="Center"
                        Margin="0,0,0,6"/>

                <DataGrid ItemsSource="{Binding Tints}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                    <DataGrid.Columns>

                        <!-- Height -->
                        <DataGridTextColumn Header="Height"
                            Binding="{Binding NormalizedHeight,
                                              StringFormat={}{0:0.00}}"
                            Width="100"/>

                        <!-- Color -->
                        <DataGridTemplateColumn Header="Color"
                                Width="*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="80"
                                        Height="24"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        Background="{Binding Color, Converter={StaticResource SKColorToBrushConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>
