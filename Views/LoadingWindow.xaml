<ui:ModelessDialog x:Class="RealmStudioX.WPF.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:SkiaSharp;assembly=SkiaSharp"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Width="600"
        Height="600"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False">

    <Grid VerticalAlignment="Top">
        <Image Margin="0" Stretch="UniformToFill" Source="pack://application:,,,/Assets/png/Realm Studio X Icon.png" Visibility="Visible"/>
        <TextBlock x:Name="LoadingStatusText" Margin="0, 320, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" Foreground="#99B0B0" Text="Starting Realm Studio X..." Visibility="Visible"/>
    </Grid>
</ui:ModelessDialog>
