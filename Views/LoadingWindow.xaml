<ui:ModelessDialog x:Class="RealmStudioX.WPF.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="clr-namespace:RealmStudioX.WPF.Editor.UserInterface"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:SkiaSharp;assembly=SkiaSharp"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Realm Studio X"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Width="600"
        Height="600"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/ico/realm_studio_icon.ico">

    <Grid VerticalAlignment="Top">
        <Image Margin="0" VerticalAlignment="Center" Stretch="UniformToFill" Source="pack://application:,,,/Assets/png/Realm Studio Icon - new.png" Visibility="Visible"/>
        <TextBlock x:Name="VersionText" Margin="0, 315, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Foreground="#C8C8C8" Text="Version" Visibility="Visible"/>
        <TextBlock x:Name="LoadingStatusText" Margin="0, 332, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" Foreground="#C8C8C8" Text="Starting Realm Studio X..." Visibility="Visible"/>
    </Grid>
</ui:ModelessDialog>
