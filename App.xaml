<Application x:Class="RealmStudioX.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:RealmStudioX.WPF.Editor.Converters"
             xmlns:local="clr-namespace:RealmStudioX.WPF"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <conv:IntToBooleanConverter x:Key="IntToBooleanConverter"/>
            <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
            <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
            <conv:SymbolHighlightConverter x:Key="SymbolHighlightConverter"/>

            <conv:BooleanToOpacityConverter
                x:Key="BooleanToOpacityConverter"
                TrueOpacity="1.0"
                FalseOpacity="0.50"/>

            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <conv:BooleanToVisibilityInverseConverter x:Key="BooleanToVisibilityInverseConverter"/>

            <conv:SKColorToBrushConverter x:Key="SKColorToBrushConverter"/>

            <conv:ContrastingBrushConverter x:Key="ContrastingBrushConverter"/>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Buttons.xaml"/>
                <ResourceDictionary Source="Themes/ToggleSwitch.xaml"/>
                <ResourceDictionary Source="Themes/ScrollBars.xaml"/>
                <ResourceDictionary Source="Themes/Sliders.xaml"/>
                <ResourceDictionary Source="Themes/ToolTips.xaml"/>
                <ResourceDictionary Source="Themes/WindowAnimations.xaml"/>
                
            </ResourceDictionary.MergedDictionaries>
           
        </ResourceDictionary>
    </Application.Resources>
    
</Application>
